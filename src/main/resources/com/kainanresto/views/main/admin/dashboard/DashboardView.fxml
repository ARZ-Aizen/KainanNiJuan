<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fx:id="dashboardView" fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="dashboard-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kainanresto.controllers.main.admin.dashboard.DashboardController">
    <content>
        <VBox styleClass="dashboard-content" spacing="28.0">

            <!-- ================= SALES ANALYTICS ================= -->
            <VBox fx:id="salesAnalyticsSection" spacing="22.0">
                <!-- Range Toggles -->
                <HBox alignment="CENTER_LEFT">
                    <!-- Period Toggle Box: Daily, Weekly, Monthly, Quarterly, Yearly -->
                    <HBox fx:id="periodToggleBox" styleClass="range-toggle" alignment="CENTER_LEFT" spacing="8.0">
                        <ToggleButton fx:id="dailyRangeBtn" text="Daily" styleClass="range-btn" onAction="#onDailyRangeSelected">
                            <toggleGroup><ToggleGroup fx:id="analyticsPeriodGroup" /></toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="weeklyRangeBtn" text="Weekly" styleClass="range-btn, range-btn-active" selected="true" toggleGroup="$analyticsPeriodGroup" onAction="#onWeeklyRangeSelected" />
                        <ToggleButton fx:id="monthlyRangeBtn" text="Monthly" styleClass="range-btn" toggleGroup="$analyticsPeriodGroup" onAction="#onMonthlyRangeSelected" />
                        <ToggleButton fx:id="quarterlyRangeBtn" text="Quarterly" styleClass="range-btn" toggleGroup="$analyticsPeriodGroup" onAction="#onQuarterlyRangeSelected" />
                        <ToggleButton fx:id="yearlyRangeBtn" text="Yearly" styleClass="range-btn" toggleGroup="$analyticsPeriodGroup" onAction="#onYearlyRangeSelected" />
                    </HBox>
                </HBox>

                <!-- Stat cards: Profit, Loss, Count, Total Menu Items (Replacing Average Spend) -->
                <HBox spacing="16.0" fillHeight="true">
                    <!-- Profit Card -->
                    <VBox styleClass="stat-card, stat-card-outlined" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Profit (Net Sales)" styleClass="stat-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane styleClass="stat-icon-shell">
                                <SVGPath fx:id="profitSalesIcon" styleClass="phosphor-icon, accent-icon" />
                            </StackPane>
                        </HBox>
                        <VBox spacing="4.0">
                            <Label fx:id="profitSalesValueLabel" text="—" styleClass="stat-value" />
                            <Label fx:id="profitSalesNoteLabel" text="Revenue from completed orders" styleClass="stat-subtext" />
                        </VBox>
                    </VBox>

                    <!-- Loss Card -->
                    <VBox styleClass="stat-card, stat-card-outlined" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Loss (Cancelled)" styleClass="stat-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane styleClass="stat-icon-shell">
                                <SVGPath fx:id="lossSalesIcon" styleClass="phosphor-icon, accent-icon" />
                            </StackPane>
                        </HBox>
                        <VBox spacing="4.0">
                            <Label fx:id="lossSalesValueLabel" text="—" styleClass="stat-value" />
                            <Label fx:id="lossSalesNoteLabel" text="Value of cancelled transactions" styleClass="stat-subtext" />
                        </VBox>
                    </VBox>

                    <!-- Orders Count Card -->
                    <VBox styleClass="stat-card, stat-card-outlined" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Orders Count" styleClass="stat-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane styleClass="stat-icon-shell">
                                <SVGPath fx:id="orderCountIcon" styleClass="phosphor-icon, accent-icon" />
                            </StackPane>
                        </HBox>
                        <VBox spacing="4.0">
                            <Label fx:id="orderCountValueLabel" text="—" styleClass="stat-value" />
                            <Label fx:id="orderCountNoteLabel" text="Total orders recorded in period" styleClass="stat-subtext" />
                        </VBox>
                    </VBox>

                    <!-- Total Menu Items Card (Retained from Dashboard, replaces Average Spend) -->
                    <VBox styleClass="stat-card, stat-card-outlined" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Total Menu Items" styleClass="stat-label" />
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane styleClass="stat-icon-shell">
                                <SVGPath fx:id="menuStatIcon" styleClass="phosphor-icon, accent-icon" />
                            </StackPane>
                        </HBox>
                        <VBox spacing="4.0">
                            <Label fx:id="totalMenuItemsValueLabel" text="—" styleClass="stat-value" />
                            <Label fx:id="totalMenuItemsSubLabel" text="—" styleClass="stat-subtext" />
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Min & Max Date Sales Highlights -->
                <HBox spacing="16.0" fillHeight="true">
                    <!-- Peak Sales Record -->
                    <VBox styleClass="stat-card-highlight" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="PEAK SALES RECORD" styleClass="highlight-badge-peak" />
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane styleClass="stat-icon-shell">
                                <SVGPath fx:id="peakSalesIcon" styleClass="phosphor-icon, accent-icon" />
                            </StackPane>
                        </HBox>
                        <VBox spacing="4.0">
                            <Label fx:id="maxSalesValueLabel" text="—" styleClass="highlight-card-value" />
                            <Label fx:id="maxSalesDateLabel" text="—" styleClass="highlight-card-sub" />
                            <Label text="Highest sales interval recorded in this period" styleClass="highlight-card-note" />
                        </VBox>
                    </VBox>

                    <!-- Lowest Sales Record -->
                    <VBox styleClass="stat-card-highlight" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="LOWEST SALES RECORD" styleClass="highlight-badge-low" />
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane styleClass="stat-icon-shell">
                                <SVGPath fx:id="lowestSalesIcon" styleClass="phosphor-icon, accent-icon" />
                            </StackPane>
                        </HBox>
                        <VBox spacing="4.0">
                            <Label fx:id="minSalesValueLabel" text="—" styleClass="highlight-card-value" />
                            <Label fx:id="minSalesDateLabel" text="—" styleClass="highlight-card-sub" />
                            <Label text="Lowest sales interval recorded in this period" styleClass="highlight-card-note" />
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Graphs & Period Data Overview -->
                <HBox spacing="20.0" fillHeight="true">
                    <!-- Left: Sales BarChart -->
                    <VBox styleClass="section-card, analytics-card, stat-card-outlined" spacing="16.0" HBox.hgrow="ALWAYS">
                        <VBox spacing="4.0">
                            <Label fx:id="salesChartTitleLabel" text="Weekly Sales Analytics Trend" styleClass="section-title" />
                            <Label fx:id="salesChartSubtitleLabel" text="Sales performance over selected period" styleClass="section-subtitle" />
                        </VBox>
                        <BarChart fx:id="salesBarChart" prefHeight="350.0" minHeight="300.0" legendVisible="false" animated="false"
                                  horizontalGridLinesVisible="false" verticalGridLinesVisible="false" barGap="4.0" categoryGap="28.0"
                                  styleClass="weekly-sales-chart, sales-bar-chart">
                            <xAxis><CategoryAxis fx:id="salesXAxis" side="BOTTOM" tickMarkVisible="false" /></xAxis>
                            <yAxis><NumberAxis fx:id="salesYAxis" side="LEFT" forceZeroInRange="true" autoRanging="true" tickMarkVisible="false" /></yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Right: Period Overview & Breakdown -->
                    <VBox styleClass="section-card, analytics-card, stat-card-outlined" prefWidth="340.0" minWidth="300.0" maxWidth="380.0" spacing="16.0">
                        <Label text="Period Overview &amp; Data" styleClass="lower-title" />
                        <VBox spacing="12.0">
                            <VBox spacing="2.0">
                                <Label text="Gross Period Sales" styleClass="summary-label" />
                                <Label fx:id="grossSalesValueLabel" text="—" styleClass="summary-value" />
                            </VBox>
                            <VBox spacing="2.0">
                                <Label text="Periodic Average Sales" styleClass="summary-label" />
                                <Label fx:id="avgPeriodicSalesLabel" text="—" styleClass="summary-value" />
                            </VBox>
                            <VBox spacing="2.0">
                                <Label text="Total Items Sold" styleClass="summary-label" />
                                <Label fx:id="totalItemsSoldLabel" text="—" styleClass="summary-value" />
                            </VBox>
                            <Region styleClass="summary-divider" />
                            <Label text="Sales by Order Type" styleClass="summary-label" />
                            <VBox fx:id="orderTypesBreakdownBox" spacing="8.0" />
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ================= LOWER SECTION: BEST SELLERS ================= -->
            <VBox styleClass="section-card, lower-card" spacing="16.0">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Best-Selling Menu Items" styleClass="lower-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Volume Ranked" styleClass="volume-badge" />
                </HBox>
                <VBox fx:id="bestSellingItemsContainer" styleClass="best-seller-list" spacing="0.0">
                    <Label text="No dashboard data loaded." styleClass="dashboard-placeholder" />
                </VBox>
            </VBox>

            <!-- ================= LOWER SECTION: RECENT TRANSACTIONS ================= -->
            <VBox styleClass="section-card, lower-card" spacing="14.0">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Recent Transactions" styleClass="lower-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="viewAllOrdersBtn" text="View All in Sales &amp; Orders →" styleClass="view-all-btn" onAction="#onViewAllOrders" />
                </HBox>
                <TableView fx:id="recentOrdersTable" styleClass="orders-table, orders-table-fixed" fixedCellSize="52.0" prefHeight="298.0" minHeight="298.0" maxHeight="298.0" focusTraversable="false">
                    <placeholder>
                        <Label text="No recent transactions found." styleClass="dashboard-placeholder" />
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="recentOrderIdColumn" text="ORDER ID" prefWidth="100.0" minWidth="90.0" sortable="false" reorderable="false" styleClass="col-first, col-id" />
                        <TableColumn fx:id="recentOrderTypeColumn" text="TYPE" prefWidth="85.0" minWidth="75.0" sortable="false" reorderable="false" styleClass="col-type" />
                        <TableColumn fx:id="recentOrderStaffColumn" text="STAFF" prefWidth="200.0" minWidth="160.0" sortable="false" reorderable="false" />
                        <TableColumn fx:id="recentOrderCreatedColumn" text="CREATED / LAST EDIT" prefWidth="170.0" minWidth="140.0" sortable="false" reorderable="false" styleClass="col-time" />
                        <TableColumn fx:id="recentOrderTotalColumn" text="TOTAL" prefWidth="100.0" minWidth="90.0" sortable="false" reorderable="false" styleClass="col-total" />
                        <TableColumn fx:id="recentOrderStatusColumn" text="STATUS" prefWidth="120.0" minWidth="100.0" sortable="false" reorderable="false" />
                        <TableColumn fx:id="recentOrderPaymentColumn" text="PAYMENT" prefWidth="110.0" minWidth="90.0" sortable="false" reorderable="false" />
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </content>
</ScrollPane>