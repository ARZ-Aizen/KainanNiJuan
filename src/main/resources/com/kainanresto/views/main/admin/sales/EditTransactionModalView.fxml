<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kainanresto.controllers.main.admin.sales.EditTransactionModalController"
      stylesheets="@../../../../styles/util/EditTransactionModalView.css"
      styleClass="edit-modal-root"
      spacing="0" prefWidth="860">

    <!-- Modal Header -->
    <HBox alignment="CENTER_LEFT" styleClass="edit-modal-header">
        <VBox spacing="2">
            <Label text="Edit Transaction" styleClass="edit-modal-title" style="-fx-text-fill: #2E2520;"/>
            <Label fx:id="modalSubtitleLabel" text="Modify items, order type, status, or discount"
                   styleClass="edit-modal-subtitle" style="-fx-text-fill: #6E625C;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#onCancel" text="✕" styleClass="edit-modal-close-btn"
                focusTraversable="false" mnemonicParsing="false"/>
    </HBox>

    <!-- Modal Body -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                styleClass="receipt-scroll"
                style="-fx-background-color: transparent; -fx-padding: 0; -fx-border-color: transparent;">
        <HBox spacing="20" style="-fx-padding: 20 24 16 24;">

            <!-- Left Column: Order Settings & Items List -->
            <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="460">

                <!-- Order Settings Card -->
                <VBox spacing="12" styleClass="edit-card"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #EAE1D4; -fx-border-width: 1; -fx-border-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(140,99,67,0.06), 14, 0, 0, 4);">
                    <Label text="Order Information" styleClass="edit-card-title"
                           style="-fx-font-family: 'Roboto'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E2520;"/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Order Type" styleClass="edit-field-label"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #5D4037;"/>
                            <ComboBox fx:id="orderTypeCombo" styleClass="edit-combo" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Order Status" styleClass="edit-field-label"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #5D4037;"/>
                            <ComboBox fx:id="orderStatusCombo" styleClass="edit-combo" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Ordered Items Card -->
                <VBox spacing="14" styleClass="edit-card"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #EAE1D4; -fx-border-width: 1; -fx-border-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(140,99,67,0.06), 14, 0, 0, 4);">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Ordered Dishes" styleClass="edit-card-title"
                               style="-fx-font-family: 'Roboto'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E2520;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="itemsCountLabel" text="0 items"
                               style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #8C6343;"/>
                    </HBox>

                    <!-- Items Header aligned precisely with item rows -->
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 12 6 12;">
                        <Label text="Dish" minWidth="120" HBox.hgrow="ALWAYS"
                               style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #8C6343;"/>
                        <Label text="Price" prefWidth="70" minWidth="70" maxWidth="70" alignment="CENTER_RIGHT"
                               style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #8C6343;"/>
                        <Label text="Quantity" prefWidth="96" minWidth="96" maxWidth="96" alignment="CENTER"
                               style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #8C6343;"/>
                        <Label text="Total" prefWidth="80" minWidth="80" maxWidth="80" alignment="CENTER_RIGHT"
                               style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #8C6343;"/>
                        <Region prefWidth="28" minWidth="28" maxWidth="28"/>
                    </HBox>

                    <!-- Items Container -->
                    <VBox fx:id="itemsContainer" spacing="8"/>

                    <Region style="-fx-min-height: 1; -fx-background-color: #EAE1D4;"/>

                    <!-- Add Dish Section -->
                    <VBox spacing="8">
                        <Label text="Add Item to Order"
                               style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #2E2520;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ComboBox fx:id="addDishCombo" promptText="Select a dish to add..."
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="edit-combo"/>
                            <TextField fx:id="addDishQtyField" text="1" prefWidth="54" minWidth="54" maxWidth="54" alignment="CENTER"
                                       styleClass="edit-input"/>
                            <Button fx:id="addDishBtn" text="+ Add" onAction="#onAddDish"
                                    minWidth="76" prefWidth="76" styleClass="modal-add-btn" mnemonicParsing="false"/>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>

            <!-- Right Column: Discount & Summary -->
            <VBox spacing="16" prefWidth="300" minWidth="280">

                <!-- Discount Card -->
                <VBox spacing="12" styleClass="edit-card"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #EAE1D4; -fx-border-width: 1; -fx-border-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(140,99,67,0.06), 14, 0, 0, 4);">
                    <Label text="Discount" styleClass="edit-card-title"
                           style="-fx-font-family: 'Roboto'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E2520;"/>
                    <VBox spacing="6">
                        <Label text="Discount Type" styleClass="edit-field-label"
                               style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #5D4037;"/>
                        <ComboBox fx:id="discountCombo" styleClass="edit-combo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox fx:id="discountCardsBox" spacing="6" managed="false" visible="false">
                        <Label text="Discount cards (1 card = 1 dish)"
                               style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #6E625C;"/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Button onAction="#onDiscountCardsMinus" text="-"
                                    styleClass="modal-stepper-btn" minWidth="32" minHeight="32" prefWidth="32" prefHeight="32"
                                    mnemonicParsing="false"/>
                            <Label fx:id="discountCardsLabel" text="1" alignment="CENTER" prefWidth="36"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2E2520;"/>
                            <Button onAction="#onDiscountCardsPlus" text="+"
                                    styleClass="modal-stepper-btn" minWidth="32" minHeight="32" prefWidth="32" prefHeight="32"
                                    mnemonicParsing="false"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Order Summary Card -->
                <VBox spacing="10" styleClass="edit-card"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #EAE1D4; -fx-border-width: 1; -fx-border-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(140,99,67,0.06), 14, 0, 0, 4);">
                    <Label text="Order Summary" styleClass="edit-card-title"
                           style="-fx-font-family: 'Roboto'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E2520;"/>
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Subtotal" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #2E2520;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="subtotalValueLabel" text="₱0.00"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #2E2520;"/>
                        </HBox>
                        <HBox fx:id="discountRow" alignment="CENTER_LEFT" managed="false" visible="false">
                            <Label fx:id="discountLabel" text="Discount"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #2E2520;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="discountValueLabel" text="-₱0.00"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #E74C3C;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="serviceChargeLabel" text="Service Charge (5%)"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #2E2520;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="serviceChargeValueLabel" text="₱0.00"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #2E2520;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="vatLabel" text="VAT (12%)"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #2E2520;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="vatValueLabel" text="₱0.00"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #2E2520;"/>
                        </HBox>
                    </VBox>

                    <Region style="-fx-min-height: 1.5; -fx-background-color: #8C6343;"/>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="TOTAL"
                               style="-fx-font-family: 'Inter'; -fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2E2520;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalValueLabel" text="₱0.00"
                               style="-fx-font-family: 'Inter'; -fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #8C6343;"/>
                    </HBox>
                </VBox>
            </VBox>

        </HBox>
    </ScrollPane>

    <!-- Modal Footer -->
    <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="edit-modal-footer">
        <Label fx:id="errorLabel" text=""
               style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #E74C3C; -fx-font-weight: 600;"
               wrapText="true" maxWidth="450"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" onAction="#onCancel"
                styleClass="edit-cancel-btn" mnemonicParsing="false"/>
        <Button fx:id="saveBtn" text="Save Changes" onAction="#onSaveChanges"
                styleClass="edit-save-btn" mnemonicParsing="false"/>
    </HBox>

</VBox>
