<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<HBox fx:id="settingsRoot" spacing="24" alignment="TOP_LEFT" styleClass="settings-page"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kainanresto.controllers.main.admin.settings.SettingsController">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>
    <fx:define>
        <ToggleGroup fx:id="settingsSyncGroup"/>
    </fx:define>

    <!-- Left tab list -->
    <VBox styleClass="settings-tabs" spacing="6" minWidth="260" prefWidth="260" maxWidth="260" maxHeight="-Infinity">
        <Button fx:id="settingsTabTimeBtn" text="Time &amp; Date" styleClass="settings-tab, settings-tab-active"
                maxWidth="Infinity" mnemonicParsing="false" onAction="#onSettingsTabTime">
            <graphic>
                <StackPane styleClass="settings-host-18">
                    <SVGPath fx:id="settingsGeneralIcon" styleClass="phosphor-icon"/>
                </StackPane>
            </graphic>
        </Button>
        <Button fx:id="settingsTabBackupBtn" text="Backup &amp; Restore" styleClass="settings-tab"
                maxWidth="Infinity" mnemonicParsing="false" onAction="#onSettingsTabBackup">
            <graphic>
                <StackPane styleClass="settings-host-18">
                    <SVGPath fx:id="settingsBackupTabIcon" styleClass="phosphor-icon"/>
                </StackPane>
            </graphic>
        </Button>
        <Button fx:id="settingsTabSecurityBtn" text="Security" styleClass="settings-tab"
                maxWidth="Infinity" mnemonicParsing="false" onAction="#onSettingsTabSecurity">
            <graphic>
                <StackPane styleClass="settings-host-18">
                    <SVGPath fx:id="settingsSecurityIcon" styleClass="phosphor-icon"/>
                </StackPane>
            </graphic>
        </Button>
    </VBox>

    <!-- Right: scrolling cards -->
    <ScrollPane fx:id="settingsScroll" styleClass="settings-scroll" fitToWidth="true" hbarPolicy="NEVER" HBox.hgrow="ALWAYS">
        <content>
            <VBox fx:id="settingsContent" styleClass="settings-content" spacing="24">

                <!-- Time & Date -->
                <VBox fx:id="settingsTimeCard" styleClass="settings-card" spacing="20">
                    <VBox spacing="4">
                        <Label text="System Time &amp; Date" styleClass="settings-card-title"/>
                        <Label text="Manage how the POS terminal tracks and records transaction timestamps"
                               styleClass="settings-card-subtitle" wrapText="true"/>
                    </VBox>
                    <Region styleClass="settings-divider"/>
                    <VBox spacing="16">
                        <VBox spacing="6">
                            <Label text="System Time Sync Mode" styleClass="settings-field-label"/>
                            <HBox styleClass="settings-segment" spacing="4">
                                <ToggleButton fx:id="settingsSyncManualBtn" text="Manually Change" toggleGroup="$settingsSyncGroup"
                                              styleClass="settings-segment-btn" mnemonicParsing="false"
                                              maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                <ToggleButton fx:id="settingsSyncAutoBtn" text="Auto Sync" toggleGroup="$settingsSyncGroup"
                                              styleClass="settings-segment-btn" mnemonicParsing="false"
                                              maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                        <HBox spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="0">
                                <Label text="System Date" styleClass="settings-field-label"/>
                                <TextField fx:id="settingsDateField" promptText="e.g., October 2, 2026" styleClass="settings-input"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="0">
                                <Label text="System Time" styleClass="settings-field-label"/>
                                <TextField fx:id="settingsTimeField" promptText="e.g., 10:30 AM" styleClass="settings-input"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Export Operations -->
                <VBox fx:id="settingsBackupCard" styleClass="settings-card" spacing="20">
                    <VBox spacing="4">
                        <Label text="Sales Data Export" styleClass="settings-card-title"/>
                        <Label text="Download a comprehensive CSV spreadsheet of all processed transactions and sales history for your records."
                               styleClass="settings-card-subtitle" wrapText="true"/>
                    </VBox>
                    <Region styleClass="settings-divider"/>
                    <HBox spacing="12">
                        <Button text="Export Sales (Excel)" styleClass="settings-btn, settings-btn-primary"
                                mnemonicParsing="false" onAction="#onSettingsBackupDatabase">
                            <graphic>
                                <StackPane styleClass="settings-host-16">
                                    <SVGPath fx:id="settingsBackupBtnIcon" styleClass="phosphor-icon"/>
                                </StackPane>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Terminal & Security Protocols (Ito ang nawawala) -->
                <VBox fx:id="settingsSecurityCard" styleClass="settings-card" spacing="20">
                    <VBox spacing="4">
                        <Label text="Terminal &amp; Security Protocols" styleClass="settings-card-title"/>
                        <Label text="Authorize secure operational states across active hardware nodes"
                               styleClass="settings-card-subtitle" wrapText="true"/>
                    </VBox>
                    <Region styleClass="settings-divider"/>
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2" minWidth="0" prefWidth="360" maxWidth="360">
                            <Label text="Require PIN for Voiding Orders" styleClass="settings-row-title"/>
                            <Label text="Staff must enter an authorized Admin account to void active transactions."
                                   styleClass="settings-row-desc" wrapText="true"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ToggleButton fx:id="settingsRequirePinToggle" styleClass="settings-switch"
                                      contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false">
                            <graphic><Region styleClass="settings-switch-knob"/></graphic>
                        </ToggleButton>
                    </HBox>
                </VBox>

                <!-- Footer -->
                <HBox alignment="CENTER_RIGHT" spacing="16" styleClass="settings-footer">
                    <Label fx:id="settingsErrorLabel" styleClass="settings-error" visible="false" managed="false"/>
                    <Button text="Cancel" styleClass="settings-footer-cancel" mnemonicParsing="false"
                            onAction="#onSettingsCancel"/>
                    <Button text="Save Changes" styleClass="settings-footer-save" mnemonicParsing="false"
                            onAction="#onSettingsSave"/>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</HBox>