<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<BorderPane fx:id="appRoot"
            prefWidth="1920.0"
            prefHeight="1051.0"
            minWidth="1280.0"
            minHeight="780.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kainanresto.controllers.main.AdminController"
            stylesheets="@../../styles/main/AdminView.css">

    <left>
        <VBox fx:id="sidebarRoot" styleClass="sidebar" viewOrder="-1">

            <StackPane styleClass="logo-shell">
                <ImageView fx:id="restaurantLogoImage"
                           fitWidth="68.0"
                           fitHeight="68.0"
                           preserveRatio="true"
                           pickOnBounds="true">
                    <image>
                        <Image url="@../../images/id/KainanNiJuanLogo.png" />
                    </image>
                </ImageView>
            </StackPane>

            <VBox styleClass="primary-nav" VBox.vgrow="ALWAYS" alignment="TOP_CENTER" spacing="24.0">
                <Button fx:id="navDashboardBtn" onAction="#onNavDashboard"
                        styleClass="nav-item, nav-item-active"
                        mnemonicParsing="false" contentDisplay="GRAPHIC_ONLY">
                    <tooltip><Tooltip text="Dashboard" /></tooltip>
                    <graphic>
                        <StackPane styleClass="nav-icon-host">
                            <SVGPath fx:id="dashboardIcon" styleClass="phosphor-icon" />
                        </StackPane>
                    </graphic>
                </Button>

                <Button fx:id="navMenuBtn" onAction="#onNavMenu"
                        styleClass="nav-item"
                        mnemonicParsing="false" contentDisplay="GRAPHIC_ONLY">
                    <tooltip><Tooltip text="Menu" /></tooltip>
                    <graphic>
                        <StackPane styleClass="nav-icon-host">
                            <SVGPath fx:id="menuIcon" styleClass="phosphor-icon" />
                        </StackPane>
                    </graphic>
                </Button>

                <Button fx:id="navSalesOrdersBtn" onAction="#onNavSalesOrders"
                        styleClass="nav-item"
                        mnemonicParsing="false" contentDisplay="GRAPHIC_ONLY">
                    <tooltip><Tooltip text="Sales &amp; Orders" /></tooltip>
                    <graphic>
                        <StackPane styleClass="nav-icon-host">
                            <SVGPath fx:id="salesOrdersIcon" styleClass="phosphor-icon" />
                        </StackPane>
                    </graphic>
                </Button>

                <Button fx:id="navAccountManagementBtn" onAction="#onNavAccountManagement"
                        styleClass="nav-item"
                        mnemonicParsing="false" contentDisplay="GRAPHIC_ONLY">
                    <tooltip><Tooltip text="Account Management" /></tooltip>
                    <graphic>
                        <StackPane styleClass="nav-icon-host">
                            <SVGPath fx:id="accountManagementIcon" styleClass="phosphor-icon" />
                        </StackPane>
                    </graphic>
                </Button>

                <Button fx:id="navSettingsBtn" onAction="#onNavSettings"
                        styleClass="nav-item"
                        mnemonicParsing="false" contentDisplay="GRAPHIC_ONLY">
                    <tooltip><Tooltip text="Settings" /></tooltip>
                    <graphic>
                        <StackPane styleClass="nav-icon-host">
                            <SVGPath fx:id="settingsIcon" styleClass="phosphor-icon" />
                        </StackPane>
                    </graphic>
                </Button>
            </VBox>

            <VBox styleClass="sidebar-bottom" alignment="CENTER" spacing="16.0">
                <Region styleClass="sidebar-divider" />
                <Button fx:id="logoutBtn" onAction="#onLogout"
                        styleClass="nav-item, logout-item"
                        mnemonicParsing="false" contentDisplay="GRAPHIC_ONLY">
                    <tooltip><Tooltip text="Log out" /></tooltip>
                    <graphic>
                        <StackPane styleClass="logout-icon-host">
                            <SVGPath fx:id="logoutIcon" styleClass="phosphor-icon" />
                        </StackPane>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <center>
        <BorderPane styleClass="workspace">
            <top>
                <HBox styleClass="topbar" alignment="CENTER_LEFT">
                    <VBox spacing="4.0">
                        <Label fx:id="pageTitleLabel" styleClass="page-title" />
                        <Label fx:id="pageSubtitleLabel" styleClass="page-subtitle" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox styleClass="date-box" alignment="CENTER_LEFT" spacing="8.0">
                        <StackPane prefWidth="16.0" prefHeight="16.0" styleClass="topbar-icon-host">
                            <SVGPath fx:id="calendarIcon" styleClass="phosphor-icon" />
                        </StackPane>
                        <Label fx:id="currentDateLabel" styleClass="current-date" />
                    </HBox>
                </HBox>
            </top>

            <center>
                <StackPane fx:id="viewStack" styleClass="view-stack">
                    <!-- ============================== DASHBOARD VIEW ============================== -->
                    <ScrollPane fx:id="dashboardView"
                                fitToWidth="true"
                                fitToHeight="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                pannable="false"
                                styleClass="dashboard-scroll">
                        <content>
                            <VBox styleClass="dashboard-content" spacing="28.0" visible="true">
                                <!-- Stat Cards -->
                                <HBox fx:id="statCardsRow" spacing="20.0" styleClass="stat-cards-row" fillHeight="true">
                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="0.0">
                                            <Label text="Today's Sales" styleClass="stat-label" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <StackPane prefWidth="36.0" prefHeight="36.0" styleClass="stat-icon-shell">
                                                <SVGPath fx:id="salesStatIcon" styleClass="phosphor-icon, accent-icon" />
                                            </StackPane>
                                        </HBox>
                                        <VBox spacing="4.0">
                                            <Label fx:id="todaysSalesValueLabel" text="—" styleClass="stat-value" />
                                            <Label fx:id="todaysSalesDeltaLabel" text="—" styleClass="stat-subtext" />
                                        </VBox>
                                    </VBox>

                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Transactions" styleClass="stat-label" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <StackPane prefWidth="36.0" prefHeight="36.0" styleClass="stat-icon-shell">
                                                <SVGPath fx:id="transactionsStatIcon" styleClass="phosphor-icon, accent-icon" />
                                            </StackPane>
                                        </HBox>
                                        <VBox spacing="4.0">
                                            <Label fx:id="transactionsValueLabel" text="—" styleClass="stat-value" />
                                            <Label fx:id="transactionsSubLabel" text="—" styleClass="stat-subtext" />
                                        </VBox>
                                    </VBox>

                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Completed Orders" styleClass="stat-label" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <StackPane prefWidth="36.0" prefHeight="36.0" styleClass="stat-icon-shell">
                                                <SVGPath fx:id="completedOrdersStatIcon" styleClass="phosphor-icon,accent-icon" />
                                            </StackPane>
                                        </HBox>
                                        <VBox spacing="4.0">
                                            <Label fx:id="completedOrdersValueLabel" text="—" styleClass="stat-value" />
                                            <Label fx:id="completedOrdersSubLabel" text="—" styleClass="stat-subtext" />
                                        </VBox>
                                    </VBox>

                                    <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Total Menu Items" styleClass="stat-label" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <StackPane prefWidth="36.0" prefHeight="36.0" styleClass="stat-icon-shell">
                                                <SVGPath fx:id="menuStatIcon" styleClass="phosphor-icon, accent-icon" />
                                            </StackPane>
                                        </HBox>
                                        <VBox spacing="4.0">
                                            <Label fx:id="totalMenuItemsValueLabel" text="—" styleClass="stat-value" />
                                            <Label fx:id="totalMenuItemsSubLabel" text="—" styleClass="stat-subtext" />
                                        </VBox>
                                    </VBox>
                                </HBox>

                                <!-- Weekly Sales Analytics -->
                                <VBox styleClass="section-card, analytics-card" spacing="24.0" VBox.vgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="4.0">
                                            <Label text="Weekly Sales Analytics" styleClass="section-title" />
                                            <Label text="Visualizing net revenue trends over the past 7 days" styleClass="section-subtitle" />
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <HBox styleClass="range-toggle" spacing="8.0">
                                            <Button fx:id="rangeTodayBtn" text="Today" onAction="#onRangeToday" mnemonicParsing="false" styleClass="range-btn" />
                                            <Button fx:id="rangeWeekBtn" text="This Week" onAction="#onRangeWeek" mnemonicParsing="false" styleClass="range-btn, range-btn-active" />
                                            <Button fx:id="rangeMonthBtn" text="This Month" onAction="#onRangeMonth" mnemonicParsing="false" styleClass="range-btn" />
                                        </HBox>
                                    </HBox>

                                    <HBox spacing="32.0" alignment="CENTER_LEFT">
                                        <StackPane HBox.hgrow="ALWAYS" prefHeight="28.0" styleClass="chart-wrapper">
                                            <BarChart fx:id="weeklySalesChart"
                                                      prefHeight="280.0"
                                                      minHeight="260.0"
                                                      legendVisible="false"
                                                      animated="false"
                                                      horizontalGridLinesVisible="false"
                                                      verticalGridLinesVisible="false"
                                                      alternativeRowFillVisible="false"
                                                      horizontalZeroLineVisible="false"
                                                      verticalZeroLineVisible="false"
                                                      barGap="0.0"
                                                      categoryGap="34.0"
                                                      styleClass="weekly-sales-chart">
                                                <xAxis>
                                                    <CategoryAxis fx:id="weeklySalesXAxis" side="BOTTOM" tickMarkVisible="false" />
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis fx:id="weeklySalesYAxis" side="LEFT" forceZeroInRange="true" autoRanging="true" tickLabelsVisible="false" tickMarkVisible="false" minorTickVisible="false" />
                                                </yAxis>
                                            </BarChart>
                                        </StackPane>

                                        <VBox prefWidth="380.0" maxHeight="-Infinity" styleClass="analytics-summary-card" spacing="20.0">
                                            <VBox spacing="4.0">
                                                <Label text="Total Weekly Sales" styleClass="summary-label" />
                                                <Label fx:id="totalWeeklySalesLabel" text="—" styleClass="summary-value" />
                                            </VBox>
                                            <Region styleClass="summary-divider" />
                                            <VBox spacing="4.0">
                                                <Label text="Weekly Orders Count" styleClass="summary-label" />
                                                <Label fx:id="weeklyOrdersCountLabel" text="—" styleClass="summary-value" />
                                            </VBox>
                                            <Region styleClass="summary-divider" />
                                            <VBox spacing="4.0">
                                                <Label text="Avg Order Value" styleClass="summary-label" />
                                                <Label fx:id="avgOrderValueLabel" text="—" styleClass="summary-value" />
                                            </VBox>
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <!-- Best Sellers + Inventory Alerts -->
                                <HBox spacing="24.0" alignment="TOP_LEFT">
                                    <VBox HBox.hgrow="ALWAYS" styleClass="section-card, lower-card" spacing="16.0">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Best-Selling Menu Items" styleClass="lower-title" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label text="Volume Ranked" styleClass="volume-badge" />
                                        </HBox>

                                        <VBox fx:id="bestSellingItemsContainer" styleClass="best-seller-list" spacing="0.0">
                                            <Label text="No dashboard data loaded." styleClass="dashboard-placeholder" />
                                        </VBox>
                                    </VBox>

                                    <VBox HBox.hgrow="ALWAYS" styleClass="section-card, lower-card" spacing="16.0">
                                        <Label text="Inventory Alerts" styleClass="lower-title" />

                                        <VBox fx:id="lowStockAlertsContainer" spacing="8.0">
                                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                                <Region styleClass="alert-dot, alert-warning" />
                                                <Label text="Low Stock" styleClass="alert-heading, warning-text" />
                                            </HBox>
                                            <Label text="No low-stock data loaded." styleClass="dashboard-placeholder" />
                                        </VBox>

                                        <VBox fx:id="outOfStockAlertsContainer" spacing="8.0">
                                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                                <Region styleClass="alert-dot, alert-critical" />
                                                <Label text="Out of Stock" styleClass="alert-heading, critical-text" />
                                            </HBox>
                                            <Label text="No out-of-stock data loaded." styleClass="dashboard-placeholder" />
                                        </VBox>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </content>
                    </ScrollPane>

                    <!-- ============================== MENU MANAGEMENT VIEW ============================== -->
                    <VBox fx:id="menuView" visible="false" managed="false" styleClass="menu-page" spacing="24.0">

                        <!-- Toolbar: search, add button, category chips -->
                        <VBox styleClass="menu-toolbar-card" spacing="14.0">
                            <HBox alignment="CENTER_LEFT" spacing="16.0">
                                <HBox fx:id="menuSearchBox" styleClass="search-box" alignment="CENTER_LEFT" spacing="10.0">
                                    <StackPane styleClass="icon-host-14">
                                        <SVGPath fx:id="menuSearchIcon" styleClass="phosphor-icon, icon-muted" />
                                    </StackPane>
                                    <TextField fx:id="menuSearchField" promptText="Search dishes..."
                                               styleClass="search-input" HBox.hgrow="ALWAYS" />
                                </HBox>

                                <Region HBox.hgrow="ALWAYS" />

                                <Button fx:id="addDishBtn" text="Add New Dish" onAction="#onAddDish"
                                        styleClass="btn-primary" mnemonicParsing="false"
                                        contentDisplay="LEFT" graphicTextGap="8.0">
                                    <graphic>
                                        <StackPane styleClass="icon-host-16">
                                            <SVGPath fx:id="addDishIcon" styleClass="phosphor-icon, icon-on-primary" />
                                        </StackPane>
                                    </graphic>
                                </Button>
                            </HBox>

                            <Region styleClass="toolbar-divider" />

                            <!-- Chips ("All" + categories) are generated from backend data -->
                            <FlowPane fx:id="menuCategoryChips" hgap="10.0" vgap="10.0" styleClass="category-chips" />
                        </VBox>

                        <!-- Dish grid (cards are generated from backend data) -->
                        <ScrollPane fx:id="menuGridScroll" fitToWidth="true" fitToHeight="false"
                                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                    VBox.vgrow="ALWAYS" styleClass="menu-grid-scroll">
                            <content>
                                <StackPane styleClass="menu-grid-holder">
                                    <FlowPane fx:id="dishGrid" hgap="24.0" vgap="24.0" alignment="TOP_LEFT" styleClass="dish-grid" />
                                    <Label fx:id="dishGridPlaceholder" text="No dishes loaded."
                                           styleClass="dashboard-placeholder" StackPane.alignment="TOP_LEFT" />
                                </StackPane>
                            </content>
                        </ScrollPane>
                    </VBox>

                    <!-- ============ ADD MENU ITEM ============ -->
                    <!-- ============ ADD MENU ITEM ============ -->
                    <ScrollPane fx:id="addDishView" visible="false" managed="false"
                                fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                styleClass="edit-account-scroll">
                        <content>
                            <VBox styleClass="add-dish-page" spacing="24">
                                <fx:define>
                                    <ToggleGroup fx:id="addDishStatusGroup"/>
                                </fx:define>

                                <HBox spacing="24" fillHeight="false" alignment="TOP_LEFT">

                                    <!-- LEFT: Menu Item Information -->
                                    <VBox styleClass="add-card" spacing="16" HBox.hgrow="ALWAYS" prefWidth="0">
                                        <Label text="Menu Item Information" styleClass="add-card-title"/>

                                        <HBox spacing="40" alignment="TOP_LEFT">
                                            <VBox spacing="8">
                                                <Label text="Menu Item Picture" styleClass="add-label"/>
                                                <StackPane fx:id="addDishPhotoBox" styleClass="add-upload-box"
                                                           onMouseClicked="#onAddDishChoosePhoto">
                                                    <VBox alignment="CENTER" spacing="6">
                                                        <StackPane styleClass="add-host-24">
                                                            <SVGPath fx:id="addDishUploadIcon" styleClass="phosphor-icon, icon-brand"/>
                                                        </StackPane>
                                                        <Label text="Upload Photo" styleClass="add-upload-text"/>
                                                    </VBox>
                                                </StackPane>
                                            </VBox>

                                            <VBox spacing="8" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
                                                <Label text="Live Catalog Preview" styleClass="add-preview-title"/>
                                                <StackPane styleClass="add-preview-shell">
                                                    <ImageView fx:id="addDishPreviewImage" fitWidth="76.0" fitHeight="76.0"
                                                               preserveRatio="true"/>
                                                </StackPane>
                                            </VBox>
                                        </HBox>

                                        <VBox spacing="6">
                                            <HBox spacing="4" alignment="CENTER_LEFT">
                                                <Label text="Menu Item Name" styleClass="add-label"/>
                                                <Label text="*" styleClass="add-required"/>
                                            </HBox>
                                            <TextField fx:id="addDishNameField" styleClass="add-input"/>
                                        </VBox>

                                        <HBox spacing="16">
                                            <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="0">
                                                <HBox spacing="4" alignment="CENTER_LEFT">
                                                    <Label text="Category" styleClass="add-label"/>
                                                    <Label text="*" styleClass="add-required"/>
                                                </HBox>
                                                <ComboBox fx:id="addDishCategoryCombo" maxWidth="Infinity"
                                                          promptText="Select category" styleClass="add-combo"/>
                                            </VBox>
                                            <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="0">
                                                <HBox spacing="4" alignment="CENTER_LEFT">
                                                    <Label text="Selling Price (PHP)" styleClass="add-label"/>
                                                    <Label text="*" styleClass="add-required"/>
                                                </HBox>
                                                <HBox styleClass="add-price-box" alignment="CENTER_LEFT">
                                                    <Label text="₱" styleClass="add-price-prefix"/>
                                                    <TextField fx:id="addDishPriceField" promptText="0.00"
                                                               styleClass="add-price-field" HBox.hgrow="ALWAYS"/>
                                                </HBox>
                                            </VBox>
                                        </HBox>

                                        <VBox spacing="6">
                                            <Label text="Description" styleClass="add-label"/>
                                            <TextArea fx:id="addDishDescriptionField" prefRowCount="3" wrapText="true"
                                                      styleClass="add-input-area"/>
                                        </VBox>

                                        <!-- Quantity stepper + Status -->
                                        <HBox spacing="16" alignment="TOP_LEFT">
                                            <VBox spacing="6" minWidth="170" prefWidth="170" maxWidth="170">
                                                <HBox spacing="4" alignment="CENTER_LEFT">
                                                    <Label text="Quantity" styleClass="add-label"/>
                                                    <Label text="*" styleClass="add-required"/>
                                                </HBox>
                                                <HBox styleClass="add-stepper" alignment="CENTER_LEFT">
                                                    <Button text="−" onAction="#onAddDishQtyMinus"
                                                            styleClass="add-stepper-btn, add-stepper-btn-left" mnemonicParsing="false"
                                                            focusTraversable="false"/>
                                                    <TextField fx:id="addDishQuantityField" text="0"
                                                               styleClass="add-stepper-field" HBox.hgrow="ALWAYS"/>
                                                    <Button text="+" onAction="#onAddDishQtyPlus"
                                                            styleClass="add-stepper-btn, add-stepper-btn-right" mnemonicParsing="false"
                                                            focusTraversable="false"/>
                                                </HBox>
                                            </VBox>

                                            <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="0">
                                                <HBox spacing="4" alignment="CENTER_LEFT">
                                                    <Label text="Status" styleClass="add-label"/>
                                                    <Label text="*" styleClass="add-required"/>
                                                </HBox>
                                                <HBox spacing="12">
                                                    <ToggleButton fx:id="addDishAvailableBtn" text="Available"
                                                                  toggleGroup="$addDishStatusGroup" selected="true"
                                                                  styleClass="add-status-btn" mnemonicParsing="false"
                                                                  maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                                    <ToggleButton fx:id="addDishUnavailableBtn" text="Unavailable"
                                                                  toggleGroup="$addDishStatusGroup"
                                                                  styleClass="add-status-btn" mnemonicParsing="false"
                                                                  maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                                </HBox>
                                            </VBox>
                                        </HBox>
                                    </VBox>

                                    <!-- RIGHT: Dish Category Creator -->
                                    <VBox styleClass="add-card, add-card-outlined" spacing="16" HBox.hgrow="ALWAYS" prefWidth="0">
                                        <VBox spacing="4">
                                            <Label text="Dish Category Creator" styleClass="add-card-title"/>
                                            <Label text="Create the categories used to group dishes on your menu. New categories appear in the Category dropdown right away."
                                                   styleClass="add-card-subtitle" wrapText="true"/>
                                        </VBox>

                                        <VBox spacing="6">
                                            <Label text="New Category Name" styleClass="add-label"/>
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <TextField fx:id="addCategoryNameField" promptText="e.g. Appetizers"
                                                           styleClass="add-input" HBox.hgrow="ALWAYS"/>
                                                <Button text="Add" onAction="#onAddCategory"
                                                        styleClass="add-primary-btn" mnemonicParsing="false"
                                                        contentDisplay="LEFT" graphicTextGap="6.0">
                                                    <graphic>
                                                        <StackPane styleClass="icon-host-14">
                                                            <SVGPath fx:id="addCategoryAddIcon" styleClass="phosphor-icon, icon-on-primary"/>
                                                        </StackPane>
                                                    </graphic>
                                                </Button>
                                            </HBox>
                                            <Label fx:id="addCategoryErrorLabel" styleClass="settings-error"
                                                   visible="false" managed="false"/>
                                        </VBox>

                                        <Region styleClass="add-ing-divider"/>

                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Existing Categories" styleClass="add-label"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="addCategoryCountLabel" text="0 categories" styleClass="add-count-badge"/>
                                        </HBox>

                                        <VBox fx:id="addCategoryList" spacing="8"/>
                                        <Label fx:id="addCategoryEmptyLabel" text="No categories yet. Add your first one above."
                                               styleClass="add-empty"/>
                                    </VBox>
                                </HBox>

                                <!-- Footer -->
                                <HBox alignment="CENTER_RIGHT" spacing="16">
                                    <Label fx:id="addDishErrorLabel" styleClass="settings-error" visible="false" managed="false"/>
                                    <Button text="Cancel" onAction="#onAddDishCancel" styleClass="add-cancel-btn" mnemonicParsing="false"/>
                                    <Button text="Save Menu Item" onAction="#onAddDishSave" styleClass="add-save-btn" mnemonicParsing="false"/>
                                </HBox>
                            </VBox>
                        </content>
                    </ScrollPane>

                    <!-- ============================== SALES & ORDERS VIEW ============================== -->
                    <VBox fx:id="salesOrdersView" visible="false" managed="false" styleClass="orders-page" spacing="24.0">

                        <!-- Stat cards -->
                        <HBox spacing="20.0" fillHeight="true">
                            <VBox styleClass="stat-card, stat-card-outlined" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Today's Revenue" styleClass="stat-label" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon-shell">
                                        <SVGPath fx:id="ordersRevenueIcon" styleClass="phosphor-icon, accent-icon" />
                                    </StackPane>
                                </HBox>
                                <VBox spacing="4.0">
                                    <Label fx:id="ordersRevenueValueLabel" text="—" styleClass="stat-value" />
                                    <Label fx:id="ordersRevenueNoteLabel" text="—" styleClass="stat-subtext" />
                                </VBox>
                            </VBox>

                            <VBox styleClass="stat-card, stat-card-outlined" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Total Orders" styleClass="stat-label" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon-shell">
                                        <SVGPath fx:id="ordersTotalIcon" styleClass="phosphor-icon, accent-icon" />
                                    </StackPane>
                                </HBox>
                                <VBox spacing="4.0">
                                    <Label fx:id="ordersTotalValueLabel" text="—" styleClass="stat-value" />
                                    <Label fx:id="ordersTotalNoteLabel" text="—" styleClass="stat-subtext" />
                                </VBox>
                            </VBox>

                            <VBox styleClass="stat-card, stat-card-outlined" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Voids &amp; Refunds" styleClass="stat-label" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon-shell">
                                        <SVGPath fx:id="ordersVoidsIcon" styleClass="phosphor-icon, accent-icon" />
                                    </StackPane>
                                </HBox>
                                <VBox spacing="4.0">
                                    <Label fx:id="ordersVoidsValueLabel" text="—" styleClass="stat-value" />
                                    <Label fx:id="ordersVoidsNoteLabel" text="—" styleClass="stat-subtext" />
                                </VBox>
                            </VBox>

                            <VBox styleClass="stat-card, stat-card-outlined" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Average Spend" styleClass="stat-label" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon-shell">
                                        <SVGPath fx:id="ordersAvgSpendIcon" styleClass="phosphor-icon, accent-icon" />
                                    </StackPane>
                                </HBox>
                                <VBox spacing="4.0">
                                    <Label fx:id="ordersAvgSpendValueLabel" text="—" styleClass="stat-value" />
                                    <Label fx:id="ordersAvgSpendNoteLabel" text="—" styleClass="stat-subtext" />
                                </VBox>
                            </VBox>
                        </HBox>

                        <!-- Search + filters (option lists come from the backend) -->
                        <HBox styleClass="orders-toolbar-card" alignment="CENTER_LEFT" spacing="16.0">
                            <HBox fx:id="ordersSearchBox" styleClass="search-box, search-box-tinted"
                                  alignment="CENTER_LEFT" spacing="10.0">
                                <StackPane styleClass="icon-host-14">
                                    <SVGPath fx:id="ordersSearchIcon" styleClass="phosphor-icon, icon-muted" />
                                </StackPane>
                                <TextField fx:id="ordersSearchField" promptText="Search Order ID or customer..."
                                           styleClass="search-input" HBox.hgrow="ALWAYS" />
                            </HBox>

                            <Region HBox.hgrow="ALWAYS" />

                            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                <HBox fx:id="orderDatePill" styleClass="filter-pill" alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="Date:" styleClass="filter-pill-label" />
                                    <Label fx:id="orderDateValueLabel" text="—" styleClass="filter-pill-value" />
                                    <StackPane styleClass="icon-host-14"><SVGPath styleClass="phosphor-icon, icon-muted, filter-chevron" /></StackPane>
                                </HBox>
                                <HBox fx:id="orderTypePill" styleClass="filter-pill" alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="Order Type:" styleClass="filter-pill-label" />
                                    <Label fx:id="orderTypeValueLabel" text="—" styleClass="filter-pill-value" />
                                    <StackPane styleClass="icon-host-14"><SVGPath styleClass="phosphor-icon, icon-muted, filter-chevron" /></StackPane>
                                </HBox>
                                <HBox fx:id="orderStatusPill" styleClass="filter-pill" alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="Status:" styleClass="filter-pill-label" />
                                    <Label fx:id="orderStatusValueLabel" text="—" styleClass="filter-pill-value" />
                                    <StackPane styleClass="icon-host-14"><SVGPath styleClass="phosphor-icon, icon-muted, filter-chevron" /></StackPane>
                                </HBox>
                                <HBox fx:id="orderPaymentPill" styleClass="filter-pill" alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="Payment:" styleClass="filter-pill-label" />
                                    <Label fx:id="orderPaymentValueLabel" text="—" styleClass="filter-pill-value" />
                                    <StackPane styleClass="icon-host-14"><SVGPath styleClass="phosphor-icon, icon-muted, filter-chevron" /></StackPane>
                                </HBox>
                                <Button fx:id="clearOrderFiltersBtn" text="Clear Filters" onAction="#onClearOrderFilters"
                                        styleClass="btn-text" mnemonicParsing="false" />
                            </HBox>
                        </HBox>

                        <!-- Orders table (rows come from the backend) -->
                        <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
                            <TableView fx:id="ordersTable" styleClass="orders-table" VBox.vgrow="ALWAYS"
                                       fixedCellSize="61.0" minHeight="240.0" focusTraversable="false">
                                <placeholder>
                                    <Label fx:id="ordersTablePlaceholder" text="" styleClass="dashboard-placeholder" />
                                </placeholder>
                                <columns>
                                    <TableColumn fx:id="orderIdColumn" text="ORDER ID" prefWidth="100.0" minWidth="90.0"
                                                 sortable="false" reorderable="false" styleClass="col-first, col-id" />
                                    <TableColumn fx:id="orderTypeColumn" text="TYPE" prefWidth="100.0" minWidth="80.0"
                                                 sortable="false" reorderable="false" styleClass="col-type" />
                                    <TableColumn fx:id="orderStaffColumn" text="STAFF" prefWidth="180.0" minWidth="120.0"
                                                 sortable="false" reorderable="false" />
                                    <TableColumn fx:id="orderCreatedColumn" text="CREATED / LAST EDIT" prefWidth="180.0" minWidth="150.0"
                                                 sortable="false" reorderable="false" styleClass="col-time" />
                                    <TableColumn fx:id="orderTotalColumn" text="TOTAL" prefWidth="100.0" minWidth="80.0"
                                                 sortable="false" reorderable="false" styleClass="col-total" />
                                    <TableColumn fx:id="orderStatusColumn" text="STATUS" prefWidth="120.0" minWidth="110.0"
                                                 sortable="false" reorderable="false" />
                                    <TableColumn fx:id="orderPaymentColumn" text="PAYMENT" prefWidth="120.0" minWidth="100.0"
                                                 sortable="false" reorderable="false" />
                                    <TableColumn fx:id="orderActionsColumn" text="ACTIONS" prefWidth="72.0" minWidth="72.0" maxWidth="72.0"
                                                 resizable="false" sortable="false" reorderable="false" styleClass="col-center" />
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>

                    <!-- ============ ACCOUNT MANAGEMENT ============ -->
                    <VBox fx:id="accountsView" visible="false" managed="false" spacing="24" styleClass="accounts-page">

                        <!-- Filter card -->
                        <VBox styleClass="accounts-card, accounts-filter-card">
                            <HBox alignment="CENTER_LEFT" spacing="16">
                                <HBox fx:id="accountsSearchBox" styleClass="accounts-search-box" alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                                    <StackPane styleClass="accounts-icon-14">
                                        <SVGPath fx:id="accountsSearchIcon" styleClass="phosphor-icon, icon-muted"/>
                                    </StackPane>
                                    <TextField fx:id="accountsSearchField" promptText="Search accounts by name or email..."
                                               styleClass="accounts-search-field" HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <HBox fx:id="accountsRolePill" styleClass="accounts-pill" alignment="CENTER_LEFT" spacing="8">
                                        <Label text="Role:" styleClass="accounts-pill-label"/>
                                        <Label fx:id="accountsRoleValueLabel" text="All Roles" styleClass="accounts-pill-value"/>
                                        <StackPane styleClass="accounts-icon-12">
                                            <SVGPath styleClass="phosphor-icon, icon-muted, accounts-pill-chevron"/>
                                        </StackPane>
                                    </HBox>
                                    <HBox fx:id="accountsStatusPill" styleClass="accounts-pill" alignment="CENTER_LEFT" spacing="8">
                                        <Label text="Status:" styleClass="accounts-pill-label"/>
                                        <Label fx:id="accountsStatusValueLabel" text="All Statuses" styleClass="accounts-pill-value"/>
                                        <StackPane styleClass="accounts-icon-12">
                                            <SVGPath styleClass="phosphor-icon, icon-muted, accounts-pill-chevron"/>
                                        </StackPane>
                                    </HBox>
                                    <HBox fx:id="accountsLastLoginPill" styleClass="accounts-pill" alignment="CENTER_LEFT" spacing="8">
                                        <Label text="Last Login:" styleClass="accounts-pill-label"/>
                                        <Label fx:id="accountsLastLoginValueLabel" text="Anytime" styleClass="accounts-pill-value"/>
                                        <StackPane styleClass="accounts-icon-12">
                                            <SVGPath styleClass="phosphor-icon, icon-muted, accounts-pill-chevron"/>
                                        </StackPane>
                                    </HBox>
                                    <Button text="Clear Filters" styleClass="accounts-clear-btn" onAction="#onAccountsClearFilters"/>
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- Table card -->
                        <VBox styleClass="accounts-card, accounts-table-card" VBox.vgrow="ALWAYS">
                            <TableView fx:id="accountsTable" styleClass="accounts-table" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="accountsColName"      text="NAME"       prefWidth="180" styleClass="col-first" sortable="false" reorderable="false"/>
                                    <TableColumn fx:id="accountsColUsername"  text="USERNAME"   prefWidth="150" sortable="false" reorderable="false"/>
                                    <TableColumn fx:id="accountsColRole"      text="ROLE"       prefWidth="120" sortable="false" reorderable="false"/>
                                    <TableColumn fx:id="accountsColStatus"    text="STATUS"     prefWidth="110" sortable="false" reorderable="false"/>
                                    <TableColumn fx:id="accountsColLastLogin" text="LAST LOGIN" prefWidth="160" sortable="false" reorderable="false"/>
                                    <TableColumn fx:id="accountsColCreated"   text="CREATED DATE" prefWidth="140" sortable="false" reorderable="false"/>
                                    <TableColumn fx:id="accountsColActions"   text="ACTIONS"    prefWidth="100" styleClass="col-center" sortable="false" reorderable="false"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>

                    <!-- ============ EDIT ACCOUNT ============ -->
                    <ScrollPane fx:id="editAccountView" visible="false" managed="false"
                                fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                styleClass="edit-account-scroll">
                        <content>
                            <StackPane alignment="CENTER" styleClass="edit-account-page">
                                <VBox alignment="CENTER" styleClass="edit-account-column">
                                    <VBox spacing="24" maxWidth="600" prefWidth="600">

                                        <!-- Account Information -->
                                        <VBox styleClass="edit-card" spacing="16">
                                            <VBox spacing="4">
                                                <Label text="Account Information" styleClass="edit-card-title"/>
                                                <Label text="Manage user's personal details and platform login identifiers."
                                                       styleClass="edit-card-subtitle" wrapText="true"/>
                                            </VBox>

                                            <VBox spacing="8">
                                                <HBox spacing="4" alignment="CENTER_LEFT">
                                                    <Label text="Full Name" styleClass="edit-field-label"/>
                                                    <Label text="*" styleClass="edit-required"/>
                                                </HBox>
                                                <TextField fx:id="editAccountNameField" styleClass="edit-input"/>
                                            </VBox>

                                            <VBox spacing="8">
                                                <HBox spacing="4" alignment="CENTER_LEFT">
                                                    <Label text="Username" styleClass="edit-field-label"/>
                                                    <Label text="*" styleClass="edit-required"/>
                                                </HBox>
                                                <TextField fx:id="editAccountUsernameField" styleClass="edit-input"/>
                                            </VBox>

                                            <VBox spacing="8">
                                                <Label text="Password" styleClass="edit-field-label"/>

                                                <!-- Password Input Box with Eye Icon (HBox and external button removed) -->
                                                <StackPane alignment="CENTER_RIGHT">
                                                    <!-- Hidden TextField for visible text -->
                                                    <TextField fx:id="editAccountVisiblePasswordField"
                                                               promptText="Leave blank to keep current password"
                                                               styleClass="edit-input, edit-input-pw"
                                                               visible="false" managed="false"/>

                                                    <!-- Standard PasswordField -->
                                                    <PasswordField fx:id="editAccountPasswordField"
                                                                   promptText="Leave blank to keep current password"
                                                                   styleClass="edit-input, edit-input-pw"/>

                                                    <!-- Eye toggle button -->
                                                    <Button fx:id="editAccountPasswordToggleBtn"
                                                            onAction="#onToggleEditAccountPasswordVisibility"
                                                            styleClass="pw-toggle-btn"
                                                            mnemonicParsing="false"
                                                            focusTraversable="false">
                                                        <graphic>
                                                            <StackPane styleClass="icon-host-16">
                                                                <!-- Eye SVG Icon (Fixed Coordinates) -->
                                                                <SVGPath styleClass="phosphor-icon, icon-muted"
                                                                         content="M12 5C7.3 5 3.1 8.3 1.2 12c1.9 3.7 6.1 7 10.8 7s8.9-3.3 10.8-7C20.9 8.3 16.7 5 12 5z m0 10c-1.7 0-3-1.3-3-3s1.3-3 3-3 3 1.3 3 3-1.3 3-3 3z"/>
                                                            </StackPane>
                                                        </graphic>
                                                        <StackPane.margin><Insets right="4"/></StackPane.margin>
                                                    </Button>
                                                </StackPane>
                                            </VBox>
                                        </VBox>

                                        <!-- Access & Status -->
                                        <VBox styleClass="edit-card" spacing="16">
                                            <VBox spacing="4">
                                                <Label text="Access &amp; Status" styleClass="edit-card-title"/>
                                                <Label text="Set platform authorization role levels and login availability status."
                                                       styleClass="edit-card-subtitle" wrapText="true"/>
                                            </VBox>
                                            <HBox spacing="20">
                                                <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="0">
                                                    <HBox spacing="4" alignment="CENTER_LEFT">
                                                        <Label text="Assigned Role" styleClass="edit-field-label"/>
                                                        <Label text="*" styleClass="edit-required"/>
                                                    </HBox>
                                                    <ComboBox fx:id="editAccountRoleCombo" maxWidth="Infinity" styleClass="edit-combo"/>
                                                </VBox>
                                                <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="0">
                                                    <HBox spacing="4" alignment="CENTER_LEFT">
                                                        <Label text="Account Status" styleClass="edit-field-label"/>
                                                        <Label text="*" styleClass="edit-required"/>
                                                    </HBox>
                                                    <ComboBox fx:id="editAccountStatusCombo" maxWidth="Infinity" styleClass="edit-combo"/>
                                                </VBox>
                                            </HBox>
                                        </VBox>

                                        <!-- System Meta Details -->
                                        <VBox styleClass="edit-card, edit-meta-card" spacing="12">
                                            <Label text="System Meta Details" styleClass="edit-meta-title"/>
                                            <HBox alignment="CENTER_LEFT">
                                                <Label text="Date Created" styleClass="edit-meta-key"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="editAccountCreatedLabel" text="—" styleClass="edit-meta-value"/>
                                            </HBox>
                                            <Region styleClass="edit-meta-divider"/>
                                            <HBox alignment="CENTER_LEFT">
                                                <Label text="Last Login Activity" styleClass="edit-meta-key"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="editAccountLastLoginLabel" text="—" styleClass="edit-meta-value"/>
                                            </HBox>
                                        </VBox>

                                        <!-- Footer -->
                                        <Region styleClass="edit-footer-divider"/>
                                        <HBox alignment="CENTER_RIGHT" spacing="16">
                                            <Label fx:id="editAccountErrorLabel" styleClass="settings-error" visible="false" managed="false"/>
                                            <Button text="Cancel" onAction="#onEditAccountCancel"
                                                    styleClass="edit-cancel-btn" mnemonicParsing="false"/>
                                            <Button text="Save Changes" onAction="#onEditAccountSave"
                                                    styleClass="edit-save-btn" mnemonicParsing="false"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </StackPane>
                        </content>
                    </ScrollPane>

                    <!-- ============ SETTINGS ============ -->
                    <HBox fx:id="settingsView" visible="false" managed="false" spacing="24" alignment="TOP_LEFT" styleClass="settings-page">
                        <padding>
                            <Insets top="32" right="32" bottom="32" left="32"/>
                        </padding>
                        <fx:define>
                            <ToggleGroup fx:id="settingsSyncGroup"/>
                        </fx:define>

                        <!-- Left tab list -->
                        <VBox styleClass="settings-tabs" spacing="6" minWidth="260" prefWidth="260" maxWidth="260" maxHeight="-Infinity">
                            <Button fx:id="settingsTabGeneralBtn" text="General" styleClass="settings-tab, settings-tab-active"
                                    maxWidth="Infinity" mnemonicParsing="false" onAction="#onSettingsTabGeneral">
                                <graphic>
                                    <StackPane styleClass="settings-host-18">
                                        <SVGPath fx:id="settingsGeneralIcon" styleClass="phosphor-icon"/>
                                    </StackPane>
                                </graphic>
                            </Button>
                            <Button fx:id="settingsTabPreferencesBtn" text="System Preferences" styleClass="settings-tab"
                                    maxWidth="Infinity" mnemonicParsing="false" onAction="#onSettingsTabPreferences">
                                <graphic>
                                    <StackPane styleClass="settings-host-18">
                                        <SVGPath fx:id="settingsPreferencesIcon" styleClass="phosphor-icon"/>
                                    </StackPane>
                                </graphic>
                            </Button>
                            <Button fx:id="settingsTabBackupBtn" text="Backup &amp; Data" styleClass="settings-tab"
                                    maxWidth="Infinity" mnemonicParsing="false" onAction="#onSettingsTabBackup">
                                <graphic>
                                    <StackPane styleClass="settings-host-18">
                                        <SVGPath fx:id="settingsBackupTabIcon" styleClass="phosphor-icon"/>
                                    </StackPane>
                                </graphic>
                            </Button>
                            <Button fx:id="settingsTabSecurityBtn" text="Security" styleClass="settings-tab"
                                    maxWidth="Infinity" mnemonicParsing="false" onAction="#onSettingsTabSecurity">
                                <graphic>
                                    <StackPane styleClass="settings-host-18">
                                        <SVGPath fx:id="settingsSecurityIcon" styleClass="phosphor-icon"/>
                                    </StackPane>
                                </graphic>
                            </Button>
                        </VBox>

                        <!-- Right: scrolling cards -->
                        <ScrollPane fx:id="settingsScroll" styleClass="settings-scroll" fitToWidth="true" hbarPolicy="NEVER" HBox.hgrow="ALWAYS">
                            <content>
                                <VBox fx:id="settingsContent" styleClass="settings-content" spacing="24">

                                    <!-- Restaurant Information -->
                                    <VBox fx:id="settingsGeneralCard" styleClass="settings-card" spacing="20">
                                        <VBox spacing="4">
                                            <Label text="Restaurant Information" styleClass="settings-card-title"/>
                                            <Label text="Update basic details and operations timing options for your restaurant"
                                                   styleClass="settings-card-subtitle" wrapText="true"/>
                                        </VBox>
                                        <Region styleClass="settings-divider"/>
                                        <VBox spacing="16">
                                            <HBox spacing="24" alignment="CENTER_LEFT">
                                                <VBox spacing="8" alignment="TOP_CENTER">
                                                    <StackPane styleClass="settings-logo-box">
                                                        <StackPane styleClass="settings-host-32">
                                                            <SVGPath fx:id="settingsLogoPlaceholderIcon" styleClass="phosphor-icon, accent-icon"/>
                                                        </StackPane>
                                                        <ImageView fx:id="settingsLogoImage" preserveRatio="true" visible="false" managed="false"/>
                                                    </StackPane>
                                                    <Button text="Change Logo" styleClass="settings-link-btn" mnemonicParsing="false"
                                                            onAction="#onSettingsChangeLogo"/>
                                                </VBox>
                                                <VBox spacing="16" HBox.hgrow="ALWAYS">
                                                    <VBox spacing="6">
                                                        <Label text="Restaurant Name" styleClass="settings-field-label"/>
                                                        <TextField fx:id="settingsNameField" promptText="—" styleClass="settings-input"/>
                                                    </VBox>
                                                    <VBox spacing="6">
                                                        <Label text="Primary Contact Email" styleClass="settings-field-label"/>
                                                        <TextField fx:id="settingsEmailField" promptText="—" styleClass="settings-input"/>
                                                    </VBox>
                                                </VBox>
                                            </HBox>

                                            <Region styleClass="settings-divider"/>

                                            <VBox spacing="16">
                                                <VBox spacing="6">
                                                    <Label text="System Time Sync Mode" styleClass="settings-field-label"/>
                                                    <HBox styleClass="settings-segment" spacing="4">
                                                        <ToggleButton fx:id="settingsSyncManualBtn" text="Manually Change" toggleGroup="$settingsSyncGroup"
                                                                      styleClass="settings-segment-btn" mnemonicParsing="false"
                                                                      maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                                        <ToggleButton fx:id="settingsSyncAutoBtn" text="Auto Sync" toggleGroup="$settingsSyncGroup"
                                                                      styleClass="settings-segment-btn" mnemonicParsing="false"
                                                                      maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                                    </HBox>
                                                </VBox>
                                                <HBox spacing="16">
                                                    <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="0">
                                                        <Label text="System Date" styleClass="settings-field-label"/>
                                                        <TextField fx:id="settingsDateField" promptText="—" styleClass="settings-input"/>
                                                    </VBox>
                                                    <VBox spacing="6" HBox.hgrow="ALWAYS" prefWidth="0">
                                                        <Label text="System Time" styleClass="settings-field-label"/>
                                                        <TextField fx:id="settingsTimeField" promptText="—" styleClass="settings-input"/>
                                                    </VBox>
                                                </HBox>
                                            </VBox>
                                        </VBox>
                                    </VBox>

                                    <!-- System Preferences -->
                                    <VBox fx:id="settingsPreferencesCard" styleClass="settings-card" spacing="20">
                                        <VBox spacing="4">
                                            <Label text="System Preferences" styleClass="settings-card-title"/>
                                            <Label text="Customize the core language options for POS terminals and back-office portals"
                                                   styleClass="settings-card-subtitle" wrapText="true"/>
                                        </VBox>
                                        <Region styleClass="settings-divider"/>
                                        <VBox spacing="6">
                                            <Label text="Default Display Language" styleClass="settings-field-label"/>
                                            <HBox fx:id="settingsLanguagePill" styleClass="settings-select" alignment="CENTER_LEFT">
                                                <Label fx:id="settingsLanguageValueLabel" text="—" styleClass="settings-select-value"
                                                       maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                                <StackPane styleClass="settings-host-16">
                                                    <SVGPath fx:id="settingsLanguageChevron" styleClass="phosphor-icon, icon-muted"/>
                                                </StackPane>
                                            </HBox>
                                        </VBox>
                                    </VBox>

                                    <!-- Backup & Data Operations -->
                                    <VBox fx:id="settingsBackupCard" styleClass="settings-card" spacing="20">
                                        <VBox spacing="4">
                                            <Label text="Backup &amp; Data Operations" styleClass="settings-card-title"/>
                                            <Label text="Perform safety operations, download localized state reports, or restore point records"
                                                   styleClass="settings-card-subtitle" wrapText="true"/>
                                        </VBox>
                                        <Region styleClass="settings-divider"/>
                                        <VBox spacing="16">
                                            <HBox alignment="CENTER_LEFT">
                                                <VBox spacing="2" minWidth="0" prefWidth="360" maxWidth="360">
                                                    <Label text="Automatic Backups" styleClass="settings-row-title"/>
                                                    <Label text="Automatically back up core database to cloud storage once a day"
                                                           styleClass="settings-row-desc" wrapText="true"/>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <ToggleButton fx:id="settingsAutoBackupToggle" styleClass="settings-switch"
                                                              contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false">
                                                    <graphic><Region styleClass="settings-switch-knob"/></graphic>
                                                </ToggleButton>
                                            </HBox>
                                            <Region styleClass="settings-divider"/>
                                            <HBox spacing="12">
                                                <Button text="Backup Database" styleClass="settings-btn, settings-btn-primary"
                                                        mnemonicParsing="false" onAction="#onSettingsBackupDatabase">
                                                    <graphic>
                                                        <StackPane styleClass="settings-host-16">
                                                            <SVGPath fx:id="settingsBackupBtnIcon" styleClass="phosphor-icon"/>
                                                        </StackPane>
                                                    </graphic>
                                                </Button>
                                                <Button text="Export Data (CSV)" styleClass="settings-btn, settings-btn-secondary"
                                                        mnemonicParsing="false" onAction="#onSettingsExportData">
                                                    <graphic>
                                                        <StackPane styleClass="settings-host-16">
                                                            <SVGPath fx:id="settingsExportBtnIcon" styleClass="phosphor-icon"/>
                                                        </StackPane>
                                                    </graphic>
                                                </Button>
                                                <Button text="Restore Point" styleClass="settings-btn, settings-btn-outline"
                                                        mnemonicParsing="false" onAction="#onSettingsRestorePoint">
                                                    <graphic>
                                                        <StackPane styleClass="settings-host-16">
                                                            <SVGPath fx:id="settingsRestoreBtnIcon" styleClass="phosphor-icon"/>
                                                        </StackPane>
                                                    </graphic>
                                                </Button>
                                            </HBox>
                                        </VBox>
                                    </VBox>

                                    <!-- Terminal & Security Protocols -->
                                    <VBox fx:id="settingsSecurityCard" styleClass="settings-card" spacing="20">
                                        <VBox spacing="4">
                                            <Label text="Terminal &amp; Security Protocols" styleClass="settings-card-title"/>
                                            <Label text="Authorize secure operational states across active hardware nodes"
                                                   styleClass="settings-card-subtitle" wrapText="true"/>
                                        </VBox>
                                        <Region styleClass="settings-divider"/>
                                        <HBox alignment="CENTER_LEFT">
                                            <VBox spacing="2" minWidth="0" prefWidth="360" maxWidth="360">
                                                <Label text="Require PIN for Sensitive Actions" styleClass="settings-row-title"/>
                                                <Label text="Staff must enter authorized security PIN to override low stock alerts, void active transactions, or issue refund slips"
                                                       styleClass="settings-row-desc" wrapText="true"/>
                                            </VBox>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <ToggleButton fx:id="settingsRequirePinToggle" styleClass="settings-switch"
                                                          contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false">
                                                <graphic><Region styleClass="settings-switch-knob"/></graphic>
                                            </ToggleButton>
                                        </HBox>
                                    </VBox>

                                    <!-- Footer -->
                                    <HBox alignment="CENTER_RIGHT" spacing="16" styleClass="settings-footer">
                                        <Label fx:id="settingsErrorLabel" styleClass="settings-error" visible="false" managed="false"/>
                                        <Button text="Cancel" styleClass="settings-footer-cancel" mnemonicParsing="false"
                                                onAction="#onSettingsCancel"/>
                                        <Button text="Save Changes" styleClass="settings-footer-save" mnemonicParsing="false"
                                                onAction="#onSettingsSave"/>
                                    </HBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </HBox>

                    <!-- Inventory is intentionally present in the same FXML so navigation can expand later. -->
                </StackPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
