<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
    Merged Admin Shell (Dashboard + Inventory)
    ============================================
    Combines DashboardView.fxml and InventoryView.fxml into a single FXML.

    Strategy:
      - One BorderPane root (adopted from InventoryView, since it's the more
        current layout style) provides the SIDEBAR (left) and a shared TOPBAR.
      - The CENTER holds a StackPane ("viewStack") with two swappable panes:
          1. dashboardView  -> everything that used to be DashboardView's main-content
          2. inventoryView  -> everything that used to be InventoryView's inventory card
      - Only one of the two views is visible/managed at a time. The controller
        toggles this in onNavDashboard()/onNavInventory() (and sets the
        active nav-item style + updates pageTitleLabel/pageSubtitleLabel).
      - fx:id collisions between the two original files were resolved by
        prefixing per-view fields (e.g. dashboardCurrentDateLabel is folded
        into the single shared currentDateLabel in the topbar instead).
      - navTeamManagementBtn/onNavTeamManagement (Dashboard) and
        navAccountManagementBtn/onNavAccountManagement (Inventory) were the
        same sidebar item under two names -> unified as
        navAccountManagementBtn / onNavAccountManagement.
-->

<BorderPane fx:id="appRoot" prefHeight="1080.0" prefWidth="1920.0" styleClass="app-root"
            stylesheets="@../../styles/main/AdminView.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kainanresto.controllers.main.AdminController">

    <!-- ============================== SIDEBAR ============================== -->
    <left>
        <VBox fx:id="sidebarRoot" maxWidth="260.0" minWidth="260.0" prefWidth="260.0" styleClass="sidebar">

            <!-- Brand / profile block -->
            <VBox spacing="2.0" styleClass="sidebar-brand">
                <padding><Insets bottom="24.0" left="20.0" right="20.0" top="28.0" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <StackPane styleClass="brand-icon-circle">
                        <!-- PLACEHOLDER glyph: replace with an ImageView when the logo asset exists -->
                        <Label styleClass="brand-icon-text" text="KJ" />
                    </StackPane>
                    <VBox spacing="1.0">
                        <Label fx:id="restaurantNameLabel" styleClass="brand-name" text="Kainan ni Juan" />
                        <Label fx:id="portalTypeLabel" styleClass="brand-subtitle" text="Admin Portal" />
                    </VBox>
                </HBox>
            </VBox>

            <Separator styleClass="sidebar-separator" />

            <!-- Navigation items -->
            <VBox fx:id="navList" spacing="4.0" styleClass="nav-list">
                <padding><Insets bottom="12.0" left="12.0" right="12.0" top="16.0" /></padding>

                <Button fx:id="navDashboardBtn" maxWidth="Infinity" onAction="#onNavDashboard" styleClass="nav-item, nav-item-active">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <ImageView fitWidth="18.0" fitHeight="18.0" preserveRatio="true" smooth="true" styleClass="nav-icon">
                                <image><Image url="@../../images/main/HomeIcon.png" /></image>
                            </ImageView>
                            <Label styleClass="nav-label" text="Home" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="navInventoryBtn" maxWidth="Infinity" onAction="#onNavInventory" styleClass="nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <ImageView fitWidth="18.0" fitHeight="18.0" preserveRatio="true" smooth="true" styleClass="nav-icon">
                                <image><Image url="@../../images/main/InventoryIcon.png" /></image>
                            </ImageView>
                            <Label styleClass="nav-label" text="Inventory" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="navMenuBtn" maxWidth="Infinity" onAction="#onNavMenu" styleClass="nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <ImageView fitWidth="18.0" fitHeight="18.0" preserveRatio="true" smooth="true" styleClass="nav-icon">
                                <image><Image url="@../../images/main/MenuIcon.png" /></image>
                            </ImageView>
                            <Label styleClass="nav-label" text="Menu" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="navSalesOrdersBtn" maxWidth="Infinity" onAction="#onNavSalesOrders" styleClass="nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <ImageView fitWidth="18.0" fitHeight="18.0" preserveRatio="true" smooth="true" styleClass="nav-icon">
                                <image><Image url="@../../images/main/SalesOrderIcon.png" /></image>
                            </ImageView>
                            <Label styleClass="nav-label" text="Sales &amp; Orders" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="navAccountManagementBtn" maxWidth="Infinity" onAction="#onNavAccountManagement" styleClass="nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefHeight="0.0" prefWidth="212.0" spacing="12.0">
                            <ImageView fitWidth="18.0" fitHeight="18.0" preserveRatio="true" smooth="true" styleClass="nav-icon">
                                <image><Image url="@../../images/main/AccountManagementIcon.png" /></image>
                            </ImageView>
                            <Label maxWidth="130.0" styleClass="nav-label" text="Account Management" wrapText="true" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="navSettingsBtn" maxWidth="Infinity" onAction="#onNavSettings" styleClass="nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <ImageView fitWidth="18.0" fitHeight="18.0" preserveRatio="true" smooth="true" styleClass="nav-icon">
                                <image><Image url="@../../images/main/SettingsIcon.png" /></image>
                            </ImageView>
                            <Label styleClass="nav-label" text="Settings" />
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Separator styleClass="sidebar-separator" />

            <!-- Logout -->
            <VBox styleClass="sidebar-footer">
                <padding><Insets bottom="24.0" left="12.0" right="12.0" top="12.0" /></padding>
                <Button fx:id="logoutBtn" maxWidth="Infinity" onAction="#onLogout" styleClass="nav-item, logout-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <ImageView fitWidth="18.0" fitHeight="18.0" preserveRatio="true" smooth="true" styleClass="nav-icon">
                                <image><Image url="@../../images/main/LogoutIcon.png" /></image>
                            </ImageView>
                            <Label styleClass="nav-label" text="Logout" />
                        </HBox>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- ============================== MAIN CONTENT ============================== -->
    <center>
        <VBox fx:id="contentRoot" styleClass="content-root">

            <!-- Shared page header bar (text driven by controller per-view) -->
            <HBox fx:id="topBar" alignment="CENTER_LEFT" styleClass="topbar">
                <HBox.margin>
                    <Insets left="36.0" right="36.0" />
                </HBox.margin>
                <padding>
                    <Insets bottom="24.0" left="0.0" right="0.0" top="24.0" />
                </padding>

                <VBox spacing="4.0">
                    <Label fx:id="pageTitleLabel" styleClass="page-title" text="Dashboard" />
                    <Label fx:id="pageSubtitleLabel" styleClass="page-subtitle"
                           text="Overview of restaurant health and inventory diagnostics" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Label styleClass="topbar-date-icon" text="🗓" />
                    <Label fx:id="currentDateLabel" styleClass="topbar-date" text="Monday, September 21, 2026" />
                </HBox>
            </HBox>

            <!-- Swappable body: exactly one of dashboardView / inventoryView is
                 visible+managed at a time (toggled in the controller) -->
            <StackPane fx:id="viewStack" VBox.vgrow="ALWAYS">

                <!-- ===================== DASHBOARD VIEW ===================== -->
                <ScrollPane fx:id="dashboardView" fitToWidth="true" styleClass="main-scroll">
                    <VBox spacing="24.0" styleClass="main-content">
                        <padding><Insets bottom="32.0" left="36.0" right="36.0" top="32.0" /></padding>

                        <!-- Stat cards row -->
                        <HBox fx:id="statCardsRow" spacing="20.0">

                            <VBox spacing="10.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="stat-card-title" text="Today's Sales" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon-badge">
                                        <Label styleClass="stat-icon-text" text="₱" />
                                    </StackPane>
                                </HBox>
                                <Label fx:id="todaysSalesValueLabel" styleClass="stat-card-value" text="--" />
                                <Label fx:id="todaysSalesDeltaLabel" styleClass="stat-card-delta-positive" text="+0.0% from yesterday" />
                            </VBox>

                            <VBox spacing="10.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="stat-card-title" text="Transactions" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon-badge">
                                        <Label styleClass="stat-icon-text" text="💳" />
                                    </StackPane>
                                </HBox>
                                <Label fx:id="transactionsValueLabel" styleClass="stat-card-value" text="--" />
                                <Label fx:id="transactionsSubLabel" styleClass="stat-card-sub" text="Average spend: --" />
                            </VBox>

                            <VBox spacing="10.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="stat-card-title" text="Completed Orders" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon-badge">
                                        <Label styleClass="stat-icon-text" text="✓" />
                                    </StackPane>
                                </HBox>
                                <Label fx:id="completedOrdersValueLabel" styleClass="stat-card-value" text="--" />
                                <Label fx:id="completedOrdersSubLabel" styleClass="stat-card-sub" text="-- pending in kitchen" />
                            </VBox>

                            <VBox spacing="10.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="stat-card-title" text="Total Menu Items" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="stat-icon-badge">
                                        <Label styleClass="stat-icon-text" text="🍴" />
                                    </StackPane>
                                </HBox>
                                <Label fx:id="totalMenuItemsValueLabel" styleClass="stat-card-value" text="--" />
                                <Label fx:id="totalMenuItemsSubLabel" styleClass="stat-card-sub" text="-- seasonal specials active" />
                            </VBox>
                        </HBox>

                        <!-- Weekly analytics row -->
                        <HBox spacing="20.0">
                            <VBox prefWidth="600.0" spacing="16.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="card-title" text="Weekly Sales Analytics" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox spacing="0.0" styleClass="toggle-group">
                                        <Button fx:id="rangeTodayBtn" onAction="#onRangeToday" styleClass="toggle-btn" text="Today" />
                                        <Button fx:id="rangeWeekBtn" onAction="#onRangeWeek" styleClass="toggle-btn, toggle-btn-active" text="This Week" />
                                        <Button fx:id="rangeMonthBtn" onAction="#onRangeMonth" styleClass="toggle-btn" text="This Month" />
                                    </HBox>
                                </HBox>
                                <Label styleClass="card-subtitle" text="Visualizing net revenue trends over the past 7 days" />

                                <HBox spacing="16.0">
                                    <BarChart fx:id="weeklySalesChart" animated="false" legendVisible="false" prefHeight="260.0" styleClass="weekly-bar-chart" HBox.hgrow="ALWAYS">
                                        <xAxis>
                                            <CategoryAxis fx:id="weeklySalesXAxis" side="BOTTOM" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="weeklySalesYAxis" side="LEFT" />
                                        </yAxis>
                                    </BarChart>

                                    <VBox minWidth="220.0" prefWidth="220.0" spacing="18.0" styleClass="weekly-summary-panel">
                                        <VBox spacing="4.0">
                                            <Label styleClass="summary-label" text="Total Weekly Sales" />
                                            <Label fx:id="totalWeeklySalesLabel" styleClass="summary-value" text="--" />
                                        </VBox>
                                        <Separator />
                                        <VBox spacing="4.0">
                                            <Label styleClass="summary-label" text="Weekly Orders Count" />
                                            <Label fx:id="weeklyOrdersCountLabel" styleClass="summary-value" text="--" />
                                        </VBox>
                                        <Separator />
                                        <VBox spacing="4.0">
                                            <Label styleClass="summary-label" text="Avg Order Value" />
                                            <Label fx:id="avgOrderValueLabel" styleClass="summary-value" text="--" />
                                        </VBox>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- Bottom row: Best-selling items + Inventory alerts -->
                        <HBox spacing="20.0">

                            <VBox prefWidth="470.0" spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="card-title" text="Best-Selling Menu Items" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label styleClass="pill-badge" text="Volume Ranked" />
                                </HBox>

                                <!-- Populated by controller: one row per item -->
                                <VBox fx:id="bestSellingItemsContainer" spacing="10.0" />
                            </VBox>

                            <VBox prefWidth="470.0" spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
                                <Label styleClass="card-title" text="Inventory Alerts" />

                                <VBox spacing="10.0">
                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                        <Label styleClass="alert-dot-warning" text="●" />
                                        <Label styleClass="alert-section-label-warning" text="LOW STOCK WARNING" />
                                    </HBox>

                                    <!-- Populated by controller -->
                                    <VBox fx:id="lowStockAlertsContainer" spacing="8.0" />

                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                        <Label styleClass="alert-dot-critical" text="●" />
                                        <Label styleClass="alert-section-label-critical" text="OUT OF STOCK CRITICAL" />
                                    </HBox>

                                    <!-- Populated by controller -->
                                    <VBox fx:id="outOfStockAlertsContainer" spacing="8.0" />
                                </VBox>
                            </VBox>
                        </HBox>

                    </VBox>
                </ScrollPane>

                <!-- ===================== INVENTORY VIEW ===================== -->
                <VBox fx:id="inventoryView" styleClass="content-body" visible="false" managed="false">

                    <padding>
                        <Insets bottom="44.0" left="36.0" right="36.0" top="36.0" />
                    </padding>

                    <!-- Inventory Card -->
                    <VBox fx:id="inventoryCard" spacing="26.0" styleClass="card" VBox.vgrow="ALWAYS">

                        <padding>
                            <Insets bottom="30.0" left="36.0" right="36.0" top="30.0" />
                        </padding>

                        <!-- Card header -->
                        <HBox fx:id="cardHeaderBox" alignment="CENTER_LEFT" spacing="16.0">
                            <Label fx:id="cardTitleLabel" styleClass="card-title" text="Inventory Stocks" />
                            <Region HBox.hgrow="ALWAYS" />
                            <ComboBox fx:id="categoryFilterCombo" prefWidth="240.0" promptText="Category" styleClass="filter-combo" />
                            <TextField fx:id="itemNameSearchField" prefWidth="300.0" promptText="Item Name..." styleClass="filter-field" />
                            <Button fx:id="deleteBtn" onAction="#onDelete" styleClass="delete-button" text="Delete" />
                        </HBox>

                        <!-- Inventory table -->
                        <TableView fx:id="inventoryTable" styleClass="inventory-table" VBox.vgrow="ALWAYS">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
                            </columnResizePolicy>

                            <placeholder>
                                <Label styleClass="table-placeholder" text="No inventory records to display." />
                            </placeholder>

                            <columns>
                                <TableColumn fx:id="skuColumn" minWidth="140.0" prefWidth="180.0" text="ITEM ID / SKU" />
                                <TableColumn fx:id="itemNameColumn" minWidth="200.0" prefWidth="370.0" text="ITEM NAME" />
                                <TableColumn fx:id="categoryColumn" minWidth="140.0" prefWidth="230.0" text="CATEGORY" />
                                <TableColumn fx:id="uomColumn" minWidth="90.0" prefWidth="140.0" text="UOM" />
                                <TableColumn fx:id="qtyOnHandColumn" minWidth="140.0" prefWidth="220.0" text="QTY ON HAND" />
                                <TableColumn fx:id="parLevelColumn" minWidth="130.0" prefWidth="190.0" text="PAR LEVEL" />
                                <TableColumn fx:id="statusColumn" minWidth="150.0" prefWidth="206.0" text="STATUS" />
                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </StackPane>

        </VBox>
    </center>
</BorderPane>
