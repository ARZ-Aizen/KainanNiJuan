<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<HBox styleClass="pos-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kainanresto.controllers.main.client.pos.ClientPosController">

    <!-- Left Column (Dishes) -->
    <VBox spacing="24" HBox.hgrow="ALWAYS">
        <padding>
            <Insets bottom="32" left="32" right="32" top="32" />
        </padding>

        <HBox alignment="CENTER_LEFT">
            <VBox spacing="4">
                <TextFlow styleClass="om-title-flow">
                    <Text styleClass="om-brand-main" text="KAINAN NI " />
                    <Text styleClass="om-brand-accent" text="JUAN" />
                </TextFlow>
                <Label fx:id="currentDateLabel" styleClass="om-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox fx:id="posSearchBox" alignment="CENTER_LEFT" spacing="12" styleClass="om-search-box">
                <StackPane styleClass="om-host-20">
                    <SVGPath fx:id="posSearchIcon" styleClass="phosphor-icon, pos-search-icon" />
                </StackPane>
                <TextField fx:id="posSearchField" promptText="Search for food, dessert, etc..." styleClass="pos-search-field" HBox.hgrow="ALWAYS" />
            </HBox>
        </HBox>

        <FlowPane fx:id="posCategoryChips" hgap="8" vgap="8" />
        <Region styleClass="pos-divider" />
        <Label styleClass="pos-section-title" text="Choose Dishes" />

        <ScrollPane fx:id="posScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="pos-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox alignment="TOP_LEFT" styleClass="pos-grid-host">
                    <Label fx:id="posGridPlaceholder" styleClass="pos-empty-label" />
                    <FlowPane fx:id="posDishGrid" alignment="TOP_LEFT" hgap="14" vgap="17" />
                </VBox>
            </content>
        </ScrollPane>
    </VBox>

    <!-- Right Column (Receipt) -->
    <VBox fx:id="receiptPanel" styleClass="receipt-panel">
        <HBox.margin><Insets bottom="32" left="0" right="32" top="32" /></HBox.margin>

        <VBox spacing="4">
            <Label styleClass="receipt-title" text="Current Order" />
            <Label styleClass="receipt-subtitle" text="Dine in" />
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="receipt-table-head">
            <Label maxWidth="Infinity" styleClass="receipt-head-label" text="Item" HBox.hgrow="ALWAYS" />
            <Label styleClass="receipt-head-label, receipt-col-qty" text="Qty" />
            <Label styleClass="receipt-head-label, receipt-col-price" text="Price" />
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="receipt-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="receiptLines" spacing="14" styleClass="receipt-lines" />
            </content>
        </ScrollPane>

        <Region styleClass="receipt-dash" />

        <VBox spacing="10">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="receipt-sum-label" text="Subtotal" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="receiptSubtotalLabel" styleClass="receipt-sum-value" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="receipt-sum-label" text="Discount" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="receiptDiscountValueLabel" styleClass="receipt-sum-value" />
                <ComboBox fx:id="receiptDiscountBox" promptText="None" styleClass="receipt-discount" />
            </HBox>

            <HBox fx:id="discountCardsRow" alignment="CENTER_LEFT" managed="false" spacing="8" visible="false">
                <Label styleClass="receipt-sum-label" text="Discount cards (1 card = 1 dish)" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onDiscountCardsMinus" styleClass="receipt-step-btn" text="−" />
                <Label fx:id="discountCardsLabel" styleClass="receipt-qty" text="1" />
                <Button mnemonicParsing="false" onAction="#onDiscountCardsPlus" styleClass="receipt-step-btn" text="+" />
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="receiptServiceLabel" styleClass="receipt-sum-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="receiptServiceValueLabel" styleClass="receipt-sum-value" />
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="receiptVatLabel" styleClass="receipt-sum-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="receiptVatValueLabel" styleClass="receipt-sum-value" />
            </HBox>
        </VBox>

        <Region styleClass="receipt-divider" />

        <HBox alignment="CENTER_LEFT">
            <Label styleClass="receipt-total-label" text="TOTAL" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="receiptTotalLabel" styleClass="receipt-total-value" />
        </HBox>

        <Button fx:id="receiptPayBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#onProceedToPayment" styleClass="receipt-pay-btn" text="PROCEED TO PAYMENT" textFill="WHITE" />
    </VBox>
</HBox>
