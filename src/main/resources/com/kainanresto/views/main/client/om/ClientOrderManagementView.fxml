<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.*?>

<HBox styleClass="om-page" visible="false" managed="false" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kainanresto.controllers.main.client.om.ClientOrderManagementController">

    <!-- Left Column (Grid) -->
    <VBox spacing="24" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <HBox alignment="CENTER_LEFT">
            <VBox spacing="4">
                <TextFlow styleClass="om-title-flow">
                    <Text text="KAINAN NI " styleClass="om-brand-main"/>
                    <Text text="JUAN" styleClass="om-brand-accent"/>
                </TextFlow>
                <Label fx:id="omSubtitleLabel" styleClass="om-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox fx:id="omSearchBox" styleClass="om-search-box" alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="om-host-20">
                    <SVGPath fx:id="omSearchIcon" styleClass="phosphor-icon, pos-search-icon"/>
                </StackPane>
                <TextField fx:id="omSearchField" promptText="Search order..."
                           styleClass="pos-search-field" HBox.hgrow="ALWAYS"/>
            </HBox>
        </HBox>

        <FlowPane fx:id="omStatusChips" hgap="8" vgap="8"/>

        <ScrollPane fx:id="omScroll" styleClass="om-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <content>
                <VBox styleClass="om-grid-host">
                    <Label fx:id="omGridPlaceholder" styleClass="pos-empty-label"/>
                    <GridPane fx:id="omGrid" hgap="20" vgap="20"/>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>

    <!-- Right Column (Receipt) -->
    <VBox fx:id="omReceiptPanel" styleClass="omr-panel" visible="false" managed="false">
        <HBox.margin><Insets top="32" right="32" bottom="32" left="0"/></HBox.margin>

        <VBox spacing="6">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="omrOrderTitleLabel" styleClass="omr-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="omrStatusLabel" styleClass="omr-badge"/>
            </HBox>
            <Label fx:id="omrTypeLabel" styleClass="omr-type"/>
        </VBox>

        <VBox styleClass="omr-info-card" spacing="10">
            <HBox alignment="CENTER_LEFT">
                <Label text="Time Placed" styleClass="omr-info-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="omrTimeLabel" styleClass="omr-info-value"/>
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label text="Cashier / Staff" styleClass="omr-info-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="omrCashierLabel" styleClass="omr-info-value"/>
            </HBox>
        </VBox>

        <HBox alignment="CENTER_LEFT">
            <Label text="Item" styleClass="omr-head-label" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Label text="Qty" styleClass="omr-head-label, omr-col-qty"/>
            <Label text="Price" styleClass="omr-head-label, omr-col-price"/>
        </HBox>
        <Region styleClass="omr-divider"/>

        <ScrollPane styleClass="omr-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="omrLines" styleClass="omr-lines" spacing="12"/>
            </content>
        </ScrollPane>

        <Region styleClass="omr-divider, omr-divider-thick"/>

        <VBox spacing="10">
            <HBox alignment="CENTER_LEFT">
                <Label text="Subtotal" styleClass="omr-sum-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="omrSubtotalLabel" styleClass="omr-sum-value"/>
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label text="Discount" styleClass="omr-sum-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="omrDiscountLabel" styleClass="omr-discount-pill"/>
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="omrServiceLabel" styleClass="omr-sum-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="omrServiceValueLabel" styleClass="omr-sum-value"/>
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="omrVatLabel" styleClass="omr-sum-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="omrVatValueLabel" styleClass="omr-sum-value"/>
            </HBox>
        </VBox>

        <Region styleClass="omr-divider, omr-divider-thick"/>

        <HBox alignment="CENTER_LEFT">
            <Label text="TOTAL" styleClass="omr-total-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="omrTotalLabel" styleClass="omr-total-value"/>
        </HBox>

        <VBox spacing="12">
            <Button fx:id="omrCompleteBtn" text="COMPLETE ORDER" mnemonicParsing="false"
                    styleClass="omr-complete-btn" maxWidth="Infinity" onAction="#onOmReceiptComplete"/>
            <Button fx:id="omrCancelBtn" text="CANCEL ORDER" mnemonicParsing="false"
                    styleClass="omr-cancel-btn" maxWidth="Infinity" onAction="#onOmReceiptCancel"/>
        </VBox>
    </VBox>
</HBox>