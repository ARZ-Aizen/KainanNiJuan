<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="appRoot" prefHeight="1080.0" prefWidth="1920.0" styleClass="app-root" stylesheets="@../styles/InventoryView.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kainanresto.controllers.InventoryController">

    <!-- ============================== SIDEBAR ============================== -->
    <left>
        <VBox fx:id="sidebarRoot" maxWidth="260.0" minWidth="260.0" prefWidth="260.0" styleClass="sidebar">

            <!-- Brand / profile block -->
            <VBox spacing="2.0" styleClass="sidebar-brand">
                <padding><Insets bottom="24.0" left="20.0" right="20.0" top="28.0" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <StackPane styleClass="brand-icon-circle">
                        <!-- PLACEHOLDER glyph: replace with an ImageView when the logo asset exists -->
                        <Label styleClass="brand-icon-text" text="Kj" />
                    </StackPane>
                    <VBox spacing="1.0">
                        <Label fx:id="restaurantNameLabel" styleClass="brand-name" text="Kainan ni Juan" />
                        <Label fx:id="portalTypeLabel" styleClass="brand-subtitle" text="Admin Portal" />
                    </VBox>
                </HBox>
            </VBox>

            <Separator styleClass="sidebar-separator" />

            <!-- Navigation items -->
            <VBox fx:id="navList" spacing="4.0" styleClass="nav-list">
                <padding><Insets bottom="12.0" left="12.0" right="12.0" top="16.0" /></padding>

                <Button fx:id="navDashboardBtn" maxWidth="Infinity" onAction="#onNavDashboard" styleClass="nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label styleClass="nav-icon" text="▦" />
                            <Label styleClass="nav-label" text="Dashboard" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="navInventoryBtn" maxWidth="Infinity" onAction="#onNavInventory" styleClass="nav-item, nav-item-active">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label styleClass="nav-icon" text="▤" />
                            <Label styleClass="nav-label" text="Inventory" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="navMenuBtn" maxWidth="Infinity" onAction="#onNavMenu" styleClass="nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label styleClass="nav-icon" text="🍴" />
                            <Label styleClass="nav-label" text="Menu" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="navSalesOrdersBtn" maxWidth="Infinity" onAction="#onNavSalesOrders" styleClass="nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label styleClass="nav-icon" text="▭" />
                            <Label styleClass="nav-label" text="Sales &amp; Orders" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="navAccountManagementBtn" maxWidth="Infinity" onAction="#onNavAccountManagement" styleClass="nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefHeight="0.0" prefWidth="212.0" spacing="12.0">
                            <Label styleClass="nav-icon" text="👥" />
                            <Label maxWidth="130.0" styleClass="nav-label" text="Account Management" wrapText="true" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="navSettingsBtn" maxWidth="Infinity" onAction="#onNavSettings" styleClass="nav-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label styleClass="nav-icon" text="⚙" />
                            <Label styleClass="nav-label" text="Settings" />
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Separator styleClass="sidebar-separator" />

            <!-- Logout -->
            <VBox styleClass="sidebar-footer">
                <padding><Insets bottom="24.0" left="12.0" right="12.0" top="12.0" /></padding>
                <Button fx:id="logoutBtn" maxWidth="Infinity" onAction="#onLogout" styleClass="nav-item, logout-item">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label styleClass="nav-icon" text="→]" />
                            <Label styleClass="nav-label" text="Logout" />
                        </HBox>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>
    <!-- ============================== MAIN CONTENT ============================== -->
    <center>
        <VBox fx:id="contentRoot" styleClass="content-root">


            <!-- Page header bar -->
            <HBox fx:id="topBar"
                  alignment="CENTER_LEFT"
                  styleClass="topbar">

                <!-- Match the horizontal position of the Inventory Card -->
                <HBox.margin>
                    <Insets left="36.0" right="36.0" />
                </HBox.margin>

                <padding>
                    <Insets bottom="24.0"
                            left="0.0"
                            right="0.0"
                            top="24.0" />
                </padding>

                <VBox spacing="4.0">
                    <Label fx:id="pageTitleLabel"
                           styleClass="page-title"
                           text="Inventory" />

                    <Label fx:id="pageSubtitleLabel"
                           styleClass="page-subtitle"
                           text="Monitor stock levels and manage your ingredients" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT"
                      spacing="10.0">

                    <Label styleClass="topbar-date-icon"
                           text="🗓" />

                    <Label fx:id="currentDateLabel"
                           styleClass="topbar-date"
                           text="Date" />

                </HBox>

            </HBox>




            <!-- Body -->
            <VBox fx:id="contentBody"
                  styleClass="content-body"
                  VBox.vgrow="ALWAYS">

                <padding>
                    <Insets bottom="44.0"
                            left="36.0"
                            right="36.0"
                            top="36.0" />
                </padding>


                <!-- Inventory Card -->
                <VBox fx:id="inventoryCard"
                      spacing="26.0"
                      styleClass="card"
                      VBox.vgrow="ALWAYS">

                    <padding>
                        <Insets bottom="30.0"
                                left="36.0"
                                right="36.0"
                                top="30.0" />
                    </padding>


                    <!-- Card header -->
                    <HBox fx:id="cardHeaderBox"
                          alignment="CENTER_LEFT"
                          spacing="16.0">

                        <Label fx:id="cardTitleLabel"
                               styleClass="card-title"
                               text="Inventory Stocks" />

                        <Region HBox.hgrow="ALWAYS" />

                        <ComboBox fx:id="categoryFilterCombo"
                                  prefWidth="240.0"
                                  promptText="Category"
                                  styleClass="filter-combo" />

                        <TextField fx:id="itemNameSearchField"
                                   prefWidth="300.0"
                                   promptText="Item Name..."
                                   styleClass="filter-field" />

                        <Button fx:id="deleteBtn"
                                onAction="#onDelete"
                                styleClass="delete-button"
                                text="Delete" />

                    </HBox>


                    <!-- Inventory table -->
                    <TableView fx:id="inventoryTable"
                               styleClass="inventory-table"
                               VBox.vgrow="ALWAYS">

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
                        </columnResizePolicy>

                        <placeholder>
                            <Label styleClass="table-placeholder"
                                   text="No inventory records to display." />
                        </placeholder>

                        <columns>

                            <TableColumn fx:id="skuColumn"
                                         minWidth="140.0"
                                         prefWidth="180.0"
                                         text="ITEM ID / SKU" />

                            <TableColumn fx:id="itemNameColumn"
                                         minWidth="200.0"
                                         prefWidth="370.0"
                                         text="ITEM NAME" />

                            <TableColumn fx:id="categoryColumn"
                                         minWidth="140.0"
                                         prefWidth="230.0"
                                         text="CATEGORY" />

                            <TableColumn fx:id="uomColumn"
                                         minWidth="90.0"
                                         prefWidth="140.0"
                                         text="UOM" />

                            <TableColumn fx:id="qtyOnHandColumn"
                                         minWidth="140.0"
                                         prefWidth="220.0"
                                         text="QTY ON HAND" />

                            <TableColumn fx:id="parLevelColumn"
                                         minWidth="130.0"
                                         prefWidth="190.0"
                                         text="PAR LEVEL" />

                            <TableColumn fx:id="statusColumn"
                                         minWidth="150.0"
                                         prefWidth="206.0"
                                         text="STATUS" />

                        </columns>

                    </TableView>

                </VBox>

            </VBox>

        </VBox>
    </center>
</BorderPane>
