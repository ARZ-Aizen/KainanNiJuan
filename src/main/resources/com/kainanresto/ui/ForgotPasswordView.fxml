<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="750.0" prefWidth="1100.0" stylesheets="@../styles/RegisterView.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kainanresto.controllers.ForgotPasswordController">

    <!-- ===================== LEFT SIDE (Standardized Width) ===================== -->
    <!-- ===================== LEFT SIDE (Locked Size) ===================== -->
    <StackPane prefWidth="550.0" minWidth="550.0" maxWidth="550.0" style="-fx-background-color: #8C6343;" HBox.hgrow="NEVER">
        <ImageView fx:id="sideGraphic" fitHeight="620.0" fitWidth="500.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/KAINAN NI JUAN.png" />
            </image>
        </ImageView>
    </StackPane>

    <!-- ===================== RIGHT SIDE ===================== -->
    <VBox alignment="CENTER" style="-fx-background-color: #F9F4EC;" HBox.hgrow="ALWAYS">

        <VBox maxWidth="500.0" spacing="12.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <!-- ===================== HEADERS GROUP ===================== -->
            <VBox spacing="0.0">
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>

                <Label text="Reset Password" textFill="#8C6343">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>

                <Label text="Enter your username and new password." textFill="#B9926D">
                    <font>
                        <Font size="16.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="-2.0" />
                    </VBox.margin>
                </Label>
            </VBox>

            <!-- ===================== INPUT FIELDS ===================== -->
            <VBox spacing="18.0">

                <!-- USERNAME -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #F9F4EC; -fx-border-color: #D5B392; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 15 0 15; -fx-pref-height: 50;">
                    <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#B9926D" />
                    <TextField fx:id="targetUsernameField" promptText="Username" style="-fx-background-color: transparent; -fx-text-fill: #8C6343; -fx-prompt-text-fill: #B9926D; -fx-padding: 0; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- NEW PASSWORD WITH TOGGLE -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #F9F4EC; -fx-border-color: #D5B392; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 10 0 15; -fx-pref-height: 50;">
                    <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z" fill="#B9926D" />
                    <StackPane alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="newPasswordField" maxWidth="Infinity" promptText="New Password" style="-fx-background-color: transparent; -fx-text-fill: #8C6343; -fx-prompt-text-fill: #B9926D; -fx-padding: 0; -fx-font-size: 14px;" />
                        <TextField fx:id="newPasswordVisibleField" managed="false" maxWidth="Infinity" promptText="New Password" style="-fx-background-color: transparent; -fx-text-fill: #8C6343; -fx-prompt-text-fill: #B9926D; -fx-padding: 0; -fx-font-size: 14px;" visible="false" />
                    </StackPane>
                    <Button fx:id="togglePasswordBtn" onAction="#handleTogglePassword" style="-fx-background-color: transparent; -fx-text-fill: #8C6343; -fx-cursor: hand; -fx-padding: 5;">
                        <graphic>
                            <SVGPath content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="#8C6343" scaleX="0.8" scaleY="0.8" />
                        </graphic>
                    </Button>
                </HBox>
            </VBox>

            <!-- PROCEED BUTTON -->
            <Button fx:id="nextButton" maxWidth="Infinity" onAction="#handleNext" style="-fx-background-color: #8C6343; -fx-text-fill: #F9F4EC; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 15; -fx-font-size: 16px; -fx-cursor: hand; -fx-letter-spacing: 2px;" text="PROCEED   ➔">
                <VBox.margin>
                    <Insets top="25.0" />
                </VBox.margin>
            </Button>

            <!-- BACK TO LOGIN LINK -->
            <HBox alignment="CENTER" spacing="5.0">
                <VBox.margin>
                    <Insets top="15.0" />
                </VBox.margin>
                <Button fx:id="backToLoginButton" onAction="#handleBackToLogin" style="-fx-background-color: transparent; -fx-text-fill: #8C6343; -fx-font-weight: bold; -fx-underline: true; -fx-padding: 0; -fx-font-size: 14px; -fx-cursor: hand;" text="Back to Login" />
            </HBox>
        </VBox>
    </VBox>

</HBox>
