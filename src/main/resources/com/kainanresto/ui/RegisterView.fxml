<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="900.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.kainanresto.controllers.RegisterController"
            stylesheets="@../styles/RegisterView.css"
            styleClass="root-pane">

    <!-- ===================== BACKGROUND ===================== -->
    <ImageView fx:id="bgImageView"
               fitHeight="900.0"
               fitWidth="900.0"
               preserveRatio="false"
               AnchorPane.topAnchor="0.0"
               AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0">

        <image>
            <Image url="@../images/Background.jpg" />
        </image>

        <effect>
            <GaussianBlur radius="6.0" />
        </effect>
    </ImageView>


    <!-- ===================== CARD ===================== -->
    <StackPane prefWidth="340.0"
               prefHeight="640.0"
               AnchorPane.topAnchor="130.0"
               AnchorPane.bottomAnchor="130.0"
               AnchorPane.leftAnchor="280.0"
               AnchorPane.rightAnchor="280.0"
               styleClass="card-pane">

        <!-- Watermark logo -->
        <ImageView fx:id="logoImageView"
                   fitWidth="220.0"
                   fitHeight="220.0"
                   preserveRatio="true"
                   opacity="0.15">

            <image>
                <Image url="@../images/KainanNiJuanLogo.png" />
            </image>
        </ImageView>


        <!-- ===================== FORM ===================== -->
        <VBox alignment="TOP_CENTER"
              spacing="6.0"
              styleClass="form-vbox">

            <padding>
                <Insets top="30.0"
                        bottom="25.0"
                        left="35.0"
                        right="35.0" />
            </padding>


            <!-- Title -->
            <Label text="CREATE ACCOUNT"
                   styleClass="title-label">

                <font>
                    <Font name="System Bold" size="24.0" />
                </font>

                <VBox.margin>
                    <Insets bottom="4.0" />
                </VBox.margin>
            </Label>


            <Label text="Register to create your account"
                   styleClass="subtitle-label"
                   wrapText="true"
                   textAlignment="CENTER">

                <VBox.margin>
                    <Insets bottom="18.0" />
                </VBox.margin>
            </Label>


            <!-- ===================== USERNAME ===================== -->
            <VBox alignment="TOP_LEFT"
                  spacing="5.0"
                  maxWidth="Infinity">

                <Label text="Username"
                       styleClass="field-label"
                       alignment="CENTER_LEFT" />

                <TextField fx:id="usernameField"
                           promptText="Enter username"
                           styleClass="input-field"
                           maxWidth="Infinity" />

                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </VBox>


            <!-- ===================== NAME ===================== -->
            <VBox alignment="TOP_LEFT"
                  spacing="5.0"
                  maxWidth="Infinity">

                <Label text="Name"
                       styleClass="field-label"
                       alignment="CENTER_LEFT" />

                <TextField fx:id="nameField"
                           promptText="Enter your name"
                           styleClass="input-field"
                           maxWidth="Infinity" />

                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </VBox>


            <!-- ===================== PASSWORD ===================== -->
            <VBox alignment="TOP_LEFT"
                  spacing="5.0"
                  maxWidth="Infinity">

                <Label text="Password"
                       styleClass="field-label"
                       alignment="CENTER_LEFT" />

                <StackPane alignment="CENTER_RIGHT">

                    <PasswordField fx:id="passwordField"
                                   promptText="Enter password"
                                   styleClass="input-field"
                                   maxWidth="Infinity" />

                    <TextField fx:id="passwordVisibleField"
                               promptText="Enter password"
                               styleClass="input-field"
                               visible="false"
                               managed="false"
                               maxWidth="Infinity" />

                    <Button fx:id="togglePasswordBtn"
                            text="👁"
                            styleClass="eye-toggle-btn"
                            onAction="#handleTogglePassword" />

                </StackPane>

                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </VBox>


            <!-- ===================== CONFIRM PASSWORD ===================== -->
            <VBox alignment="TOP_LEFT"
                  spacing="5.0"
                  maxWidth="Infinity">

                <Label text="Confirm Password"
                       styleClass="field-label"
                       alignment="CENTER_LEFT" />

                <StackPane alignment="CENTER_RIGHT">

                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Confirm password"
                                   styleClass="input-field"
                                   maxWidth="Infinity" />

                    <TextField fx:id="confirmPasswordVisibleField"
                               promptText="Confirm password"
                               styleClass="input-field"
                               visible="false"
                               managed="false"
                               maxWidth="Infinity" />

                    <Button fx:id="toggleConfirmPasswordBtn"
                            text="👁"
                            styleClass="eye-toggle-btn"
                            onAction="#handleToggleConfirmPassword" />

                </StackPane>

                <VBox.margin>
                    <Insets bottom="22.0" />
                </VBox.margin>
            </VBox>


            <!-- ===================== REGISTER BUTTON ===================== -->
            <Button fx:id="registerButton"
                    text="REGISTER"
                    styleClass="register-btn"
                    prefWidth="140.0"
                    maxWidth="140.0"
                    onAction="#handleRegister">

                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </Button>


            <!-- ===================== LOGIN LINK ===================== -->
            <Label text="Already have an account?"
                   styleClass="subtitle-label" />

            <Button fx:id="loginLinkButton"
                    text="Login"
                    styleClass="login-link-btn"
                    onAction="#handleLoginLink">

                <VBox.margin>
                    <Insets top="2.0" />
                </VBox.margin>
            </Button>

        </VBox>

    </StackPane>

</AnchorPane>

